#include <winver.h>

1 ICON "@RES@/vantix.ico"
1 24 "@RES@/vantix.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @COMMAS@
PRODUCTVERSION @COMMAS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MrcVnz"
            VALUE "FileDescription", "Vantix"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "vantix"
            VALUE "OriginalFilename", "vantix.exe"
            VALUE "ProductName", "Vantix"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
