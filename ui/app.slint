import { Theme, Icons, Icon, Card, Segmented } from "theme.slint";
import { Memory, MemoryPage, CleanState, HistoryRow } from "memory.slint";

export { Memory, CleanState, HistoryRow }
export { TermsWindow } from "terms.slint";

export global Preferences {
    in-out property <int> language;
    callback changed();
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    callback clicked;

    height: 40px;
    border-radius: Theme.radius-small;
    background: self.active ? Theme.raised : area.has-hover ? Theme.surface : transparent;
    animate background { duration: 140ms; }

    HorizontalLayout {
        padding-left: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                size: 18px;
                tint: root.active ? Theme.accent : Theme.muted;
            }
        }
        Text {
            text: root.text;
            color: root.active ? Theme.text : Theme.muted;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: -12px;
        width: 3px;
        height: root.active ? 20px : 0;
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: 180ms; easing: ease-out; }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SettingsPage inherits VerticalLayout {
    padding: 32px;
    padding-top: 26px;
    spacing: Theme.gap;
    alignment: start;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: @tr("Settings");
            color: Theme.text;
            font-family: Theme.display-font;
            font-size: 28px;
            font-weight: 700;
        }
        Text {
            text: @tr("Preferences are saved as soon as you change them.");
            color: Theme.muted;
        }
    }

    Card {
        title: @tr("Language");
        icon: Icons.globe;
        width: 440px;

        Segmented {
            options: [@tr("System"), "English", "Português"];
            selected <=> Preferences.language;
            changed => { Preferences.changed(); }
        }
    }
}

export component AppWindow inherits Window {
    property <int> page;

    title: "EasyTune";
    icon: @image-url("../res/easytune.png");
    // Fixed so the window never resizes when switching pages; the Memory page is the largest.
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 1100px;
    min-height: 760px;
    background: Theme.background;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 13px;

    // Faint glow from the top right corner so the background isn't a flat slab.
    Rectangle {
        x: parent.width - 520px;
        y: -380px;
        width: 900px;
        height: 700px;
        background: @radial-gradient(circle, Theme.accent.with-alpha(0.07) 0%, transparent 70%);
    }

    HorizontalLayout {
        Rectangle {
            width: 232px;
            background: Theme.sidebar;

            VerticalLayout {
                padding: 20px;
                padding-top: 24px;
                spacing: 4px;

                HorizontalLayout {
                    spacing: 12px;
                    padding-left: 4px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: Theme.accent.with-alpha(0.1);
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.25);
                        Image {
                            source: @image-url("../res/easytune.png");
                            width: 24px;
                            height: 24px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "EasyTune";
                            color: Theme.text;
                            font-family: Theme.display-font;
                            font-size: 17px;
                            font-weight: 700;
                        }
                        Text {
                            text: "v0.1.0";
                            color: Theme.faint;
                            font-size: 11.5px;
                        }
                    }
                }

                Rectangle { height: 22px; }

                HorizontalLayout {
                    padding-left: 12px;
                    Text {
                        text: @tr("OPTIMIZE");
                        color: Theme.faint;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1px;
                    }
                }
                Rectangle { height: 6px; }

                NavItem {
                    text: @tr("Memory");
                    icon: Icons.memory;
                    active: root.page == 0;
                    clicked => { root.page = 0; }
                }

                Rectangle { vertical-stretch: 1; }

                NavItem {
                    text: @tr("Settings");
                    icon: Icons.settings;
                    active: root.page == 1;
                    clicked => { root.page = 1; }
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }
        }

        // A plain Rectangle instead of a layout, so the active page's size hints
        // don't propagate up and resize the window.
        Rectangle {
            horizontal-stretch: 1;
            if root.page == 0: MemoryPage {
                width: parent.width;
                height: parent.height;
            }
            if root.page == 1: SettingsPage {
                width: parent.width;
                height: parent.height;
            }
        }
    }
}
