import { Theme, Icons, Icon, Card, Segmented, Toggle, Button } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Memory, MemoryPage, CleanState, HistoryRow } from "memory.slint";
import { Protection, ProtectionPage, Job, JobState, JobSheet, RestorePoint } from "protection.slint";
import { Storage, StoragePage, CleanupRow, RowState } from "storage.slint";
import { Tweaks, TweakText, TweakRow, TweakState, ChangeRow, RebootBanner, SectionPage } from "tweaks.slint";
import { Terms, TermsSheet, TermsLine, TermsParagraph } from "terms.slint";
import { Startup, StartupRow, BackgroundPage } from "startup.slint";
import { Live, ProBalanceCard, GameModeCard } from "live.slint";
import { Net, InternetPage, PingRow, BloatResult, DnsRow, UsageRow } from "internet.slint";
import { Monitor, MonitorPage, ProgramRow, Feature, GpuCard } from "monitor.slint";
import { Services, ServicesPage, ServiceRow } from "services.slint";
import { Space, SpacePage, SpaceRow } from "space.slint";
import { Dupes, DupesPage, DupRow } from "dupes.slint";
import { Input, InputPage, InputDevice } from "input.slint";

export { Memory, CleanState, HistoryRow, Protection, Job, JobState, RestorePoint, Storage, CleanupRow, RowState }
export { Tweaks, TweakText, TweakRow, TweakState, ChangeRow, Terms, TermsLine, TermsParagraph }
export { Startup, StartupRow, Live, Net, PingRow, BloatResult, DnsRow, UsageRow, Monitor, ProgramRow, Feature, GpuCard, Services, ServiceRow, Space, SpaceRow, Dupes, DupRow, Input, InputDevice, Theme }
export { Tray } from "tray.slint";

export global Preferences {
    in-out property <int> language;
    in-out property <bool> start-with-windows;
    in-out property <bool> start-minimized;
    in-out property <bool> notifications;
    // Saves everything except autostart, which has its own call because it can fail.
    callback changed();
    callback autostart-toggled(bool);
    callback reset-all();
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    callback clicked;

    height: 36px;
    border-radius: Theme.radius-small;
    background: self.active ? Theme.raised : area.has-hover ? Theme.surface : transparent;
    animate background { duration: 140ms; }

    HorizontalLayout {
        padding-left: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                size: 18px;
                tint: root.active ? Theme.accent : Theme.muted;
            }
        }
        Text {
            text: root.text;
            color: root.active ? Theme.text : Theme.muted;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: -12px;
        width: 3px;
        height: root.active ? 20px : 0;
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: 180ms; easing: ease-out; }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Holds one page. It only scrolls when the window is shorter than what the page needs,
/// so on a large screen pages fill the space as before.
component PageScroll inherits ScrollView {
    in property <length> needs;
    width: 100%;
    height: 100%;
    content-width: self.visible-width;
    content-height: max(self.visible-height, self.needs);
}

component SettingsPage inherits VerticalLayout {
    property <bool> confirm-reset;

    padding: 32px;
    padding-top: 26px;
    spacing: Theme.gap;
    alignment: start;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: @tr("Settings");
            color: Theme.text;
            font-family: Theme.display-font;
            font-size: 28px;
            font-weight: 700;
        }
        Text {
            text: @tr("Preferences are saved as soon as you change them.");
            color: Theme.muted;
        }
    }

    HorizontalLayout {
        spacing: Theme.gap;
        alignment: start;

        // Both columns give way at the minimum window width instead of running off the edge.
        VerticalLayout {
            spacing: Theme.gap;
            max-width: 460px;
            horizontal-stretch: 46;

            Card {
                title: @tr("Language");
                icon: Icons.globe;

                Segmented {
                    options: [@tr("System"), "English", "Português"];
                    selected <=> Preferences.language;
                    changed => { Preferences.changed(); }
                }
            }

            Card {
                title: @tr("Startup and tray");
                icon: Icons.power;

                Toggle {
                    text: @tr("Start with Windows");
                    detail: @tr("Runs at logon with admin rights, without a UAC prompt.");
                    checked <=> Preferences.start-with-windows;
                    toggled(on) => { Preferences.autostart-toggled(on); }
                }
                Toggle {
                    text: @tr("Start minimized to the tray");
                    detail: @tr("Only when started with Windows.");
                    enabled: Preferences.start-with-windows;
                    checked <=> Preferences.start-minimized;
                    toggled => { Preferences.changed(); }
                }
                Toggle {
                    text: @tr("Notifications");
                    detail: @tr("Tells you what automatic cleanups freed.");
                    checked <=> Preferences.notifications;
                    toggled => { Preferences.changed(); }
                }
            }
        }

        VerticalLayout {
            max-width: 380px;
            horizontal-stretch: 38;
            alignment: start;

            Card {
                title: @tr("Reset");
                icon: Icons.trash;

                Text {
                    text: @tr("Removes the startup task, notification registration and all Vantix data, then closes the app.");
                    color: Theme.muted;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: root.confirm-reset ? @tr("Click again to confirm") : @tr("Delete all Vantix data");
                        icon: Icons.trash;
                        clicked => {
                            if root.confirm-reset {
                                Preferences.reset-all();
                            } else {
                                root.confirm-reset = true;
                            }
                        }
                    }
                }
            }
        }
    }

    // The reset button asks for a second click, which expires after a few seconds.
    Timer {
        interval: 4s;
        running: root.confirm-reset;
        triggered => { root.confirm-reset = false; }
    }
}

export component AppWindow inherits Window {
    /// Read by main.rs to run the live ping and traffic count only while they're on screen.
    out property <int> page;
    /// Flipped after a restore from minimized. The background differs by one step of
    /// blue between the two values, which no one can see but makes the whole window dirty.
    in-out property <bool> repaint;

    title: "Vantix";
    // Fixed so the window never resizes when switching pages; the Memory page is the largest.
    preferred-width: 1180px;
    preferred-height: 800px;
    // Pages scroll below this. Also set by hand on the native window and lowered there to
    // fit small screens, see fit_to_screen in main.rs.
    min-width: 1000px;
    min-height: 560px;
    background: root.repaint ? Theme.background : Theme.background.brighter(0.004);
    default-font-family: Theme.text-font;
    default-font-size: 13px;

    // Faint glow from the top right corner so the background isn't a flat slab.
    Rectangle {
        x: parent.width - 520px;
        y: -380px;
        width: 900px;
        height: 700px;
        background: @radial-gradient(circle, Theme.accent.with-alpha(0.07) 0%, transparent 70%);
    }

    HorizontalLayout {
        Rectangle {
            width: 232px;
            background: Theme.sidebar;

            VerticalLayout {
                padding: 20px;
                padding-top: 24px;
                // The scroll below starts further left so the active item's marker,
                // which sits left of the item, isn't clipped.
                padding-left: 8px;
                spacing: 4px;

                HorizontalLayout {
                    spacing: 12px;
                    padding-left: 16px;
                    Image {
                        source: @image-url("../res/vantix.png");
                        // 1/8 of the 256 px art, so every pixel stays the same size.
                        width: 32px;
                        height: 32px;
                        image-rendering: pixelated;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Vantix";
                            color: Theme.text;
                            font-family: Theme.display-font;
                            font-size: 17px;
                            font-weight: 700;
                        }
                        Text {
                            text: "v0.1.0";
                            color: Theme.faint;
                            font-size: 11.5px;
                        }
                    }
                }

                // Scrolls only when the window is too short for every section, as on a
                // 1366 x 768 laptop.
                nav := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, items.min-height);
                    items := VerticalLayout {
                        width: nav.visible-width;
                        height: nav.content-height;
                        padding-left: 12px;
                        spacing: 2px;

                        Rectangle { height: 14px; }

                        HorizontalLayout {
                            padding-left: 12px;
                            Text {
                                text: @tr("OPTIMIZE");
                                color: Theme.faint;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 1px;
                            }
                        }
                        Rectangle { height: 6px; }

                        NavItem {
                            text: @tr("Memory");
                            icon: Icons.memory;
                            active: root.page == 0;
                            clicked => { root.page = 0; }
                        }
                        NavItem {
                            text: @tr("Performance");
                            icon: Icons.gauge;
                            active: root.page == 4;
                            clicked => { root.page = 4; }
                        }
                        NavItem {
                            text: @tr("Games");
                            icon: Icons.gamepad;
                            active: root.page == 5;
                            clicked => { root.page = 5; }
                        }
                        NavItem {
                            text: @tr("Internet");
                            icon: Icons.wifi;
                            active: root.page == 8;
                            clicked => { root.page = 8; }
                        }
                        NavItem {
                            text: @tr("Input");
                            icon: Icons.mouse;
                            active: root.page == 6;
                            clicked => { root.page = 6; }
                        }
                        NavItem {
                            text: @tr("Storage");
                            icon: Icons.drive;
                            active: root.page == 3;
                            clicked => { root.page = 3; }
                        }
                        NavItem {
                            text: @tr("Background");
                            icon: Icons.activity;
                            active: root.page == 7;
                            clicked => { root.page = 7; }
                        }
                        NavItem {
                            text: @tr("Services");
                            icon: Icons.layers;
                            active: root.page == 12;
                            clicked => { root.page = 12; }
                        }

                        Rectangle { height: 14px; }

                        HorizontalLayout {
                            padding-left: 12px;
                            Text {
                                text: @tr("TOOLS");
                                color: Theme.faint;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 1px;
                            }
                        }
                        Rectangle { height: 6px; }

                        NavItem {
                            text: @tr("Monitor");
                            icon: Icons.monitor;
                            active: root.page == 9;
                            clicked => { root.page = 9; }
                        }
                        NavItem {
                            text: @tr("Disk space");
                            icon: Icons.pie;
                            active: root.page == 10;
                            clicked => { root.page = 10; }
                        }
                        NavItem {
                            text: @tr("Duplicates");
                            icon: Icons.copy;
                            active: root.page == 11;
                            clicked => { root.page = 11; }
                        }

                        Rectangle { min-height: 14px; vertical-stretch: 1; }

                        HorizontalLayout {
                            padding-left: 12px;
                            Text {
                                text: @tr("SYSTEM");
                                color: Theme.faint;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 1px;
                            }
                        }
                        Rectangle { height: 6px; }

                        NavItem {
                            text: @tr("Protection");
                            icon: Icons.shield;
                            active: root.page == 2;
                            clicked => { root.page = 2; }
                        }
                        NavItem {
                            text: @tr("Settings");
                            icon: Icons.settings;
                            active: root.page == 1;
                            clicked => { root.page = 1; }
                        }
                    }
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            RebootBanner {}

            // A plain Rectangle instead of a layout, so the active page's size hints
            // don't propagate up and resize the window.
            // Each page sits in a PageScroll, which only scrolls when the window is shorter
            // than the page needs, as on a 1366 x 768 laptop or 1080p at 150%.
            Rectangle {
                vertical-stretch: 1;
                if root.page == 0: s0 := PageScroll {
                    needs: p0.min-height;
                    p0 := MemoryPage {
                        width: s0.visible-width;
                        height: s0.content-height;
                    }
                }
                if root.page == 1: s1 := PageScroll {
                    needs: p1.min-height;
                    p1 := SettingsPage {
                        width: s1.visible-width;
                        height: s1.content-height;
                    }
                }
                if root.page == 2: s2 := PageScroll {
                    needs: p2.min-height;
                    p2 := ProtectionPage {
                        width: s2.visible-width;
                        height: s2.content-height;
                    }
                }
                if root.page == 3: s3 := PageScroll {
                    needs: p3.min-height;
                    p3 := StoragePage {
                        width: s3.visible-width;
                        height: s3.content-height;
                    }
                }
                if root.page == 4: s4 := PageScroll {
                    needs: p4.min-height;
                    p4 := SectionPage {
                        width: s4.visible-width;
                        height: s4.content-height;
                        title: @tr("Performance");
                        subtitle: @tr("Power and CPU settings that trade efficiency for speed. They apply to the active power plan, while plugged in.");
                        rows: Tweaks.performance;
                        VerticalLayout {
                            padding-bottom: 12px;
                            padding-right: 12px;
                            ProBalanceCard {}
                        }
                    }
                }
                if root.page == 5: s5 := PageScroll {
                    needs: p5.min-height;
                    p5 := SectionPage {
                        width: s5.visible-width;
                        height: s5.content-height;
                        title: @tr("Games");
                        subtitle: @tr("Windows settings that affect frame rate, latency and stutter in games.");
                        rows: Tweaks.games;
                        VerticalLayout {
                            padding-bottom: 12px;
                            padding-right: 12px;
                            GameModeCard {}
                        }
                    }
                }
                if root.page == 6: s6 := PageScroll {
                    needs: p6.min-height;
                    p6 := InputPage {
                        width: s6.visible-width;
                        height: s6.content-height;
                    }
                }
                if root.page == 7: s7 := PageScroll {
                    needs: p7.min-height;
                    p7 := BackgroundPage {
                        width: s7.visible-width;
                        height: s7.content-height;
                    }
                }
                if root.page == 8: s8 := PageScroll {
                    needs: p8.min-height;
                    p8 := InternetPage {
                        width: s8.visible-width;
                        height: s8.content-height;
                    }
                }
                if root.page == 9: s9 := PageScroll {
                    needs: p9.min-height;
                    p9 := MonitorPage {
                        width: s9.visible-width;
                        height: s9.content-height;
                    }
                }
                if root.page == 10: s10 := PageScroll {
                    needs: p10.min-height;
                    p10 := SpacePage {
                        width: s10.visible-width;
                        height: s10.content-height;
                    }
                }
                if root.page == 11: s11 := PageScroll {
                    needs: p11.min-height;
                    p11 := DupesPage {
                        width: s11.visible-width;
                        height: s11.content-height;
                    }
                }
                if root.page == 12: s12 := PageScroll {
                    needs: p12.min-height;
                    p12 := ServicesPage {
                        width: s12.visible-width;
                        height: s12.content-height;
                    }
                }
            }
        }
    }

    // Overlays get an explicit position so their size hints stay out of the window's:
    // otherwise every change in the sheet's content resizes the window.
    JobSheet {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    TermsSheet {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }
}
