import { Theme, Icons, Icon, Card, Button, Chip, Tip } from "theme.slint";
import { LineEdit, ListView } from "std-widgets.slint";
import { Sparkline } from "memory.slint";

/// One process of a program, shown when its row is open.
export struct ProcessRow {
    pid: int,
    /// The program that started it, or empty.
    parent: string,
    cpu: string,
    gpu: string,
    memory: string,
}

/// Every process with the same exe name, as one row.
export struct ProgramRow {
    name: string,
    /// How many processes share the name.
    count: int,
    cpu: string,
    gpu: string,
    memory: string,
    /// 1 on, 0 off, -1 when Windows doesn't let Vantix look.
    eco: int,
    can-end: bool,
    /// What came of the last End on this row: 0 nothing, 1 ending, 2 ended, 3 protected,
    /// 4 a service, 5 reopened, 6 part of Windows, 7 still there. Then Stop service:
    /// 8 stopping, 9 stopped, 10 Windows started it again, 11 Windows refused.
    status: int,
    /// The service or the program named by status 4 and 5.
    status-name: string,
    /// Status 4, and the service isn't one Vantix keeps its hands off.
    can-stop: bool,
    /// Filled only for the open row.
    processes: [ProcessRow],
}

/// An instruction set the CPU and Windows both support. The hint comes from
/// feature-hints, by kind, so it stays translatable.
export struct Feature {
    text: string,
    kind: int,
}

export struct GpuCard {
    name: string,
    /// Driver version and driver model, already joined.
    driver: string,
    /// Used and total video memory as text, and used over total for the bar.
    memory: string,
    memory-fraction: float,
    /// Load per kind of engine, in the order of engine-labels.
    engines: [float],
}

export global Monitor {
    in property <string> cpu-name;
    in property <string> cpu-cores;
    in property <string> cpu-threads;
    /// "6 + 8" on a hybrid CPU, empty when every core is the same kind.
    in property <string> cpu-hybrid;
    in property <string> cpu-base;
    in property <string> cpu-l3;
    in property <[Feature]> features;
    /// Load per thread, grouped by physical core: the two threads of an SMT core sit
    /// side by side under one label.
    in property <[[float]]> core-groups;
    in property <string> cpu-load;
    in property <string> cpu-clock;
    in property <string> cpu-line;
    in property <string> cpu-area;

    in property <bool> has-gpu;
    in property <[GpuCard]> gpus;
    in property <string> gpu-load;
    in property <string> gpu-memory;
    in property <string> gpu-line;
    in property <string> gpu-area;

    /// Active time of the busiest drive.
    in property <string> disk-load;
    in property <string> disk-read;
    in property <string> disk-write;
    in property <string> disk-line;
    in property <string> disk-area;

    in property <string> net-total;
    in property <string> net-down;
    in property <string> net-up;
    in property <string> net-line;
    in property <string> net-area;

    /// The first reading of the performance counters is in, so the numbers are real.
    in property <bool> measured;
    in property <[ProgramRow]> programs;
    /// Everything running, before the search.
    in property <int> program-count;
    in property <int> process-count;
    in-out property <string> search;
    /// The row showing its processes, by name.
    in-out property <string> open;
    /// 0 CPU, 1 GPU, 2 memory.
    in-out property <int> sort;
    /// The pointer is over the list, so main.rs keeps the rows where they are.
    in-out property <bool> hovering;
    callback sorted(int);
    callback refilter();
    callback end(int);
    /// One process of a row: the row, then the pid.
    callback end-process(int, int);
    callback stop-service(int);
    callback eco(int, bool);
    callback trim(int);

    out property <[string]> engine-labels: [
        @tr("3D"),
        @tr("Compute"),
        @tr("Copy"),
        @tr("Video decode"),
        @tr("Video encode"),
    ];

    /// In the order of monitor.rs FEATURES.
    out property <[string]> feature-hints: [
        @tr("Does four calculations at a time. Every program built in the last fifteen years uses it."),
        @tr("Does eight calculations at a time, in video, audio and compression."),
        @tr("The whole-number half of AVX, used by compressors and by game engines."),
        @tr("Multiplies and adds in one step, in physics and image work."),
        @tr("Sixteen calculations at a time. Few programs ask for it outside servers and emulators."),
        @tr("Encrypts in hardware: disk encryption and HTTPS without the cost in CPU."),
        @tr("Hashes in hardware, which speeds up checksums and signatures."),
        @tr("Bit handling that compilers lean on, in compression and in databases."),
    ];
}

component Tile inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> detail;
    in property <string> line;
    in property <string> area;
    in property <color> tint: Theme.accent;

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: 16px;
        spacing: 4px;
        Text {
            text: root.title;
            color: Theme.muted;
            font-size: 12px;
            font-weight: 600;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-family: Theme.display-font;
            font-size: 22px;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.detail;
            color: Theme.faint;
            font-size: 12px;
            overflow: elide;
        }
        Rectangle { height: 6px; }
        Sparkline {
            height: 44px;
            line: root.line;
            area: root.area;
            tint: root.tint;
        }
    }
}

/// A label over its number, the way the processor card lists what it found.
component FactColumn inherits VerticalLayout {
    in property <string> label;
    in property <string> value;

    spacing: 2px;
    horizontal-stretch: 1;
    Text {
        text: root.label;
        color: Theme.faint;
        font-size: 11.5px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        text: root.value;
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
        overflow: elide;
    }
}

/// One bar per thread, the two threads of a core side by side under its label.
component CoreChart inherits HorizontalLayout {
    in property <[[float]]> groups;
    /// Labels get in the way once the bars are thinner than the text.
    property <bool> labelled: root.groups.length <= 20;

    spacing: root.groups.length > 16 ? 4px : 8px;
    height: root.labelled ? 76px : 62px;

    for core[i] in root.groups: VerticalLayout {
        spacing: 5px;
        horizontal-stretch: 1;

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 2px;
            for load in core: Rectangle {
                border-radius: 3px;
                background: Theme.background;
                Rectangle {
                    y: parent.height - self.height;
                    height: parent.height * clamp(load, 0, 100) / 100;
                    border-radius: 3px;
                    background: load > 85 ? Theme.warn : Theme.accent.with-alpha(0.8);
                }
            }
        }
        if root.labelled: Text {
            text: "C" + (i + 1);
            color: Theme.faint;
            font-size: 10.5px;
            horizontal-alignment: center;
        }
    }
}

/// An instruction set, with a line about what programs do with it on hover.
component FeatureChip inherits Rectangle {
    in property <Feature> feature;

    width: row.preferred-width;
    height: row.preferred-height;

    row := HorizontalLayout {
        Chip { text: root.feature.text; }
    }
    hover := TouchArea {}
    Tip {
        x: 0;
        text: Monitor.feature-hints[root.feature.kind];
        shown: hover.has-hover;
    }
}

component EngineBar inherits HorizontalLayout {
    in property <string> label;
    in property <float> load;

    spacing: 10px;
    height: 18px;

    Text {
        width: 126px;
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        horizontal-stretch: 1;
        height: 8px;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: Theme.background;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.load, 0, 100) / 100;
            height: parent.height;
            border-radius: 4px;
            background: Theme.info.with-alpha(0.85);
        }
    }
    Text {
        width: 42px;
        text: Monitor.measured ? round(root.load) + "%" : "-";
        color: Theme.text;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component SortHeading inherits Text {
    in property <int> key;
    color: Monitor.sort == root.key ? Theme.text : Theme.faint;
    font-size: 11.5px;
    font-weight: 600;
    horizontal-alignment: right;

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Monitor.sort = root.key;
            Monitor.sorted(root.key);
        }
    }
}

component Cell inherits Text {
    color: Theme.text;
    horizontal-alignment: right;
    vertical-alignment: center;
}

component ProcessLine inherits HorizontalLayout {
    in property <ProcessRow> item;
    /// Offers End for this process alone, when the row has several.
    in property <bool> can-end;
    in property <int> index;
    /// Armed by pid, like the row's End by name.
    property <int> armed: -1;

    spacing: 16px;
    padding-left: 34px;
    padding-right: 18px;
    height: 30px;

    Text {
        horizontal-stretch: 1;
        text: root.item.parent == "" ? "PID " + root.item.pid : @tr("PID {}, started by {}", root.item.pid, root.item.parent);
        color: Theme.muted;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    Cell { width: 64px; text: root.item.cpu; font-size: 12px; color: Theme.muted; }
    if Monitor.has-gpu: Cell { width: 64px; text: root.item.gpu; font-size: 12px; color: Theme.muted; }
    Cell { width: 84px; text: root.item.memory; font-size: 12px; color: Theme.muted; }
    HorizontalLayout {
        width: 270px;
        alignment: end;
        if root.can-end: VerticalLayout {
            alignment: center;
            Button {
                text: root.armed == root.item.pid ? @tr("Sure?") : @tr("End this one");
                tall: 24px;
                danger: true;
                clicked => {
                    if root.armed == root.item.pid {
                        root.armed = -1;
                        Monitor.end-process(root.index, root.item.pid);
                    } else {
                        root.armed = root.item.pid;
                    }
                }
            }
        }
    }

    Timer {
        interval: 4s;
        running: root.armed >= 0;
        triggered => { root.armed = -1; }
    }
}

component ProgramLine inherits VerticalLayout {
    in property <ProgramRow> item;
    in property <int> index;
    property <bool> open: Monitor.open == root.item.name;
    /// The program the first click on End was for. Tied to the name, not the row, so a
    /// list that reorders between the two clicks can't end something else.
    property <string> armed;
    property <bool> confirm: root.armed != "" && root.armed == root.item.name;

    HorizontalLayout {
        spacing: 16px;
        padding-left: 6px;
        // Clear of the list's scroll bar; the header lines up with it.
        padding-right: 18px;
        height: 44px;

        // The name opens the row on its processes.
        Rectangle {
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        data: root.open ? Icons.up : Icons.down;
                        size: 14px;
                        tint: name.has-hover ? Theme.text : Theme.faint;
                    }
                }
                Text {
                    text: root.item.name;
                    color: Theme.text;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.item.count > 1: Text {
                    text: "×" + root.item.count;
                    color: Theme.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if root.item.status > 0: VerticalLayout {
                    alignment: center;
                    Chip {
                        text: root.item.status == 1 ? @tr("Ending...")
                            : root.item.status == 2 ? @tr("Ended")
                            : root.item.status == 3 ? @tr("Protected by Windows")
                            : root.item.status == 4 ? @tr("Service: {}", root.item.status-name)
                            : root.item.status == 5 ? @tr("Reopened by {}", root.item.status-name)
                            : root.item.status == 6 ? @tr("Part of Windows")
                            : root.item.status == 7 ? @tr("Windows wouldn't let it end")
                            : root.item.status == 8 ? @tr("Stopping...")
                            : root.item.status == 9 ? @tr("Service stopped")
                            : root.item.status == 10 ? @tr("Windows started it again")
                            : @tr("Windows wouldn't stop it");
                        tint: root.item.status == 2 || root.item.status == 9 ? Theme.accent
                            : root.item.status == 1 || root.item.status == 8 ? Theme.muted
                            : Theme.warn;
                    }
                }
            }

            name := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Monitor.open = root.open ? "" : root.item.name;
                    Monitor.refilter();
                }
            }
        }
        Cell { width: 64px; text: root.item.cpu; }
        if Monitor.has-gpu: Cell { width: 64px; text: root.item.gpu; }
        Cell { width: 84px; text: root.item.memory; }
        HorizontalLayout {
            width: 270px;
            spacing: 6px;
            alignment: end;
            VerticalLayout {
                alignment: center;
                Button {
                    text: @tr("Eco");
                    tall: 30px;
                    primary: root.item.eco == 1;
                    enabled: root.item.eco >= 0;
                    clicked => { Monitor.eco(root.index, root.item.eco != 1); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: @tr("Trim");
                    tall: 30px;
                    clicked => { Monitor.trim(root.index); }
                }
            }
            VerticalLayout {
                alignment: center;
                // Ending a service's process only makes Windows start it again, so the button
                // stops the service instead.
                Button {
                    text: root.confirm ? @tr("Sure?") : root.item.can-stop ? @tr("Stop service") : @tr("End");
                    tall: 30px;
                    danger: true;
                    enabled: (root.item.can-end || root.item.can-stop) && root.item.status != 1 && root.item.status != 8;
                    clicked => {
                        if root.confirm {
                            root.armed = "";
                            if root.item.can-stop {
                                Monitor.stop-service(root.index);
                            } else {
                                Monitor.end(root.index);
                            }
                        } else {
                            root.armed = root.item.name;
                        }
                    }
                }
            }
        }
    }

    if root.open: VerticalLayout {
        padding-bottom: 8px;
        for process in root.item.processes: ProcessLine {
            item: process;
            index: root.index;
            can-end: root.item.count > 1 && root.item.can-end && !root.item.can-stop
                && root.item.status != 1 && root.item.status != 8;
        }
    }

    Timer {
        interval: 4s;
        running: root.armed != "";
        triggered => { root.armed = ""; }
    }
}

export component MonitorPage inherits VerticalLayout {
    padding: 32px;
    padding-top: 26px;
    spacing: Theme.gap;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: @tr("Monitor");
            color: Theme.text;
            font-family: Theme.display-font;
            font-size: 28px;
            font-weight: 700;
        }
        Text {
            text: @tr("What the PC is doing right now, updated every second while this page is open.");
            color: Theme.muted;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        spacing: Theme.gap;
        Tile {
            title: @tr("Processor");
            value: Monitor.cpu-load;
            detail: Monitor.cpu-clock == "" ? "" : @tr("Running at {}", Monitor.cpu-clock);
            line: Monitor.cpu-line;
            area: Monitor.cpu-area;
        }
        if Monitor.has-gpu: Tile {
            title: @tr("Graphics card");
            value: Monitor.gpu-load;
            detail: @tr("Video memory {}", Monitor.gpu-memory);
            line: Monitor.gpu-line;
            area: Monitor.gpu-area;
            tint: Theme.info;
        }
        Tile {
            title: @tr("Disk");
            value: Monitor.disk-load;
            detail: @tr("Read {}, write {}", Monitor.disk-read, Monitor.disk-write);
            line: Monitor.disk-line;
            area: Monitor.disk-area;
            tint: Theme.warn;
        }
        Tile {
            title: @tr("Network");
            value: Monitor.net-total;
            detail: @tr("Down {}, up {}", Monitor.net-down, Monitor.net-up);
            line: Monitor.net-line;
            area: Monitor.net-area;
            tint: Theme.accent;
        }
    }

    // The processor beside the graphics cards, so the program list still starts on the
    // first screen.
    HorizontalLayout {
        spacing: Theme.gap;

        Card {
            title: @tr("Processor");
            horizontal-stretch: 2;

            Text {
                text: Monitor.cpu-name;
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 18px;
                FactColumn { label: @tr("Cores"); value: Monitor.cpu-cores; }
                FactColumn { label: @tr("Threads"); value: Monitor.cpu-threads; }
                if Monitor.cpu-hybrid != "": FactColumn {
                    label: @tr("P + E cores");
                    value: Monitor.cpu-hybrid;
                }
                FactColumn { label: @tr("Base clock"); value: Monitor.cpu-base; }
                FactColumn { label: @tr("Clock now"); value: Monitor.cpu-clock == "" ? "-" : Monitor.cpu-clock; }
                FactColumn { label: @tr("L3 cache"); value: Monitor.cpu-l3; }
            }

            if Monitor.features.length > 0: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for feature in Monitor.features: FeatureChip { feature: feature; }
            }

            VerticalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                Text {
                    text: @tr("Use per core");
                    color: Theme.faint;
                    font-size: 11.5px;
                    font-weight: 600;
                }
                CoreChart { groups: Monitor.core-groups; }
            }
        }

        if Monitor.has-gpu: HorizontalLayout {
            spacing: Theme.gap;
            horizontal-stretch: 2;
            for gpu in Monitor.gpus: Card {
                title: @tr("Graphics card");
                horizontal-stretch: 1;

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: gpu.name;
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: gpu.driver;
                        color: Theme.muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        Text {
                            text: @tr("Video memory");
                            color: Theme.faint;
                            font-size: 11.5px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: gpu.memory;
                            color: Theme.text;
                            font-size: 12px;
                        }
                    }
                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.background;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(gpu.memory-fraction, 0, 1);
                            height: parent.height;
                            border-radius: 4px;
                            background: Theme.info;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    for load[i] in gpu.engines: EngineBar {
                        label: Monitor.engine-labels[i];
                        load: load;
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    Card {
        pad: 14px;
        vertical-stretch: 1;

        HorizontalLayout {
            spacing: Theme.gap;
            padding-left: 6px;
            Text {
                horizontal-stretch: 1;
                text: Monitor.program-count == 0 ? ""
                    : Monitor.search == ""
                    ? @tr("{} programs running, {} processes", Monitor.program-count, Monitor.process-count)
                    : @tr("{} of {} programs", Monitor.programs.length, Monitor.program-count);
                color: Theme.text;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            LineEdit {
                width: 260px;
                placeholder-text: @tr("Search by name");
                text <=> Monitor.search;
                edited => { Monitor.refilter(); }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            padding-left: 6px;
            padding-right: 18px;
            Text {
                horizontal-stretch: 1;
                text: @tr("Program");
                color: Theme.faint;
                font-size: 11.5px;
                font-weight: 600;
            }
            SortHeading { width: 64px; key: 0; text: @tr("CPU"); }
            if Monitor.has-gpu: SortHeading { width: 64px; key: 1; text: @tr("GPU"); }
            SortHeading { width: 84px; key: 2; text: @tr("Memory"); }
            Text {
                width: 270px;
                text: @tr("Click a column to sort");
                color: Theme.faint;
                font-size: 11.5px;
                horizontal-alignment: right;
            }
        }

        if Monitor.programs.length == 0: Text {
            x: 6px;
            text: Monitor.program-count == 0 ? @tr("Measuring...") : @tr("No program by that name.");
            color: Theme.faint;
        }

        // Tall enough for a handful of rows when the window is short; the page scrolls to it.
        list := TouchArea {
            min-height: 280px;
            vertical-stretch: 1;
            ListView {
                for program[i] in Monitor.programs: ProgramLine {
                    item: program;
                    index: i;
                }
            }
            changed has-hover => { Monitor.hovering = self.has-hover; }
        }
    }
}
