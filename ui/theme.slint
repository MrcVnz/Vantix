export component Icon inherits Rectangle {
    in property <string> data;
    in property <brush> tint: Theme.text;
    in property <length> size: 18px;
    in property <length> thickness: 1.8px;

    width: self.size;
    height: self.size;

    Path {
        width: 100%;
        height: 100%;
        commands: root.data;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        fill: transparent;
    }
}

export component Card inherits Rectangle {
    in property <string> title;
    in property <string> icon;
    in property <length> pad: 20px;

    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: root.pad;
        spacing: 16px;

        if root.title != "": HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if root.icon != "": VerticalLayout {
                alignment: center;
                Icon {
                    data: root.icon;
                    tint: Theme.muted;
                    size: 15px;
                }
            }
            Text {
                text: root.title;
                color: Theme.muted;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        @children
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> primary;
    /// Red, for the second click of something that can't be undone.
    in property <bool> danger;
    in property <length> tall: 40px;
    callback clicked;

    height: self.tall;
    horizontal-stretch: 0;
    border-radius: self.tall / 2;
    background: !self.enabled ? Theme.raised
        : self.danger ? Theme.bad.with-alpha(touch.has-hover ? 0.22 : 0.15)
        : self.primary ? (touch.pressed ? Theme.accent.darker(0.15) : touch.has-hover ? Theme.accent.brighter(0.08) : Theme.accent)
        : touch.pressed ? Theme.border-strong : touch.has-hover ? Theme.hover : Theme.raised;
    border-width: self.primary && self.enabled ? 0 : 1px;
    border-color: self.danger && self.enabled ? Theme.bad.with-alpha(0.5) : Theme.border;
    animate background { duration: 140ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;

        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                size: 16px;
                thickness: 2px;
                tint: !root.enabled ? Theme.faint : root.danger ? Theme.bad : root.primary ? Theme.on-accent : Theme.text;
            }
        }
        Text {
            text: root.text;
            color: !root.enabled ? Theme.faint : root.danger ? Theme.bad : root.primary ? Theme.on-accent : Theme.text;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// Pill shaped row of mutually exclusive options with a sliding highlight.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed(int);

    property <length> slot: (self.width - 8px) / max(1, self.options.length);

    height: 38px;
    border-radius: self.height / 2;
    background: Theme.background;
    border-width: 1px;
    border-color: Theme.border;

    Rectangle {
        x: 4px + root.slot * root.selected;
        y: 4px;
        width: root.slot;
        height: parent.height - 8px;
        border-radius: self.height / 2;
        background: Theme.hover;
        border-width: 1px;
        border-color: Theme.border-strong;
        animate x { duration: 220ms; easing: ease-out-quart; }
    }

    for option[i] in root.options: Rectangle {
        x: 4px + root.slot * i;
        width: root.slot;

        Text {
            text: option;
            color: i == root.selected ? Theme.text : area.has-hover ? Theme.text.transparentize(0.25) : Theme.muted;
            font-weight: 600;
            font-size: 12.5px;
            animate color { duration: 150ms; }
        }

        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if root.selected != i {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.muted;

    height: 22px;
    border-radius: 11px;
    background: self.tint.with-alpha(0.12);

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.text;
            color: root.tint;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

/// A labelled on/off switch row.
export component Toggle inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled(bool);

    // Grows with a detail that wraps, so the next row never lands on top of it.
    height: max(48px, row.preferred-height);

    row := HorizontalLayout {
        spacing: 16px;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.text;
                color: root.enabled ? Theme.text : Theme.faint;
                font-weight: 600;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 42px;
                height: 24px;
                border-radius: 12px;
                background: root.checked && root.enabled ? Theme.accent : Theme.raised;
                border-width: 1px;
                border-color: root.checked && root.enabled ? Theme.accent : Theme.border-strong;
                animate background { duration: 150ms; }

                Rectangle {
                    x: root.checked ? parent.width - self.width - 4px : 4px;
                    y: 4px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: root.checked && root.enabled ? Theme.on-accent : Theme.muted;
                    animate x { duration: 180ms; easing: ease-out-quart; }
                }
            }
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

/// Hover hint. Owners place it above themselves, so it lands on parts of the page drawn
/// before it and never ends up hidden behind later siblings.
export component Tip inherits Rectangle {
    in property <string> text;
    in property <bool> shown;
    in property <length> widest: 280px;

    width: min(label.preferred-width + 24px, root.widest);
    height: content.preferred-height;
    y: -self.height - 6px;
    background: Theme.hover;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border-strong;
    opacity: 0;

    states [
        visible when root.shown: {
            opacity: 1;
            in {
                animate opacity { delay: 400ms; duration: 120ms; }
            }
            out {
                animate opacity { duration: 80ms; }
            }
        }
    ]

    content := VerticalLayout {
        padding: 8px;
        padding-left: 12px;
        padding-right: 12px;
        label := Text {
            text: root.text;
            color: Theme.text;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
