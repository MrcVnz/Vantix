export global Theme {
    out property <color> background: #0a0b0d;
    out property <color> sidebar: #0d0f12;
    out property <color> surface: #121418;
    out property <color> raised: #181b20;
    out property <color> hover: #1d2127;
    out property <color> border: #1f232a;
    out property <color> border-strong: #2a2f37;

    out property <color> text: #f2f4f7;
    out property <color> muted: #8a919c;
    out property <color> faint: #5b626d;

    // Lime from the app icon. The software renderer has no shadows and paints gradients
    // flat inside rounded shapes, so the design sticks to solid fills.
    out property <color> accent: #9bff3c;
    out property <color> on-accent: #0a0b0d;
    out property <color> info: #5ab0ff;
    out property <color> warn: #ffb547;
    out property <color> bad: #ff5c5c;


    out property <length> radius: 16px;
    out property <length> radius-small: 10px;
    out property <length> gap: 16px;

    // Set from main.rs: Segoe UI Variable on Windows 11, Segoe UI on Windows 10.
    in-out property <string> text-font: "Segoe UI Variable Text";
    in-out property <string> display-font: "Segoe UI Variable Display";
}

