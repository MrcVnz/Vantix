import { Theme, Icons, Icon, Toggle, Chip, Button, IconButton, Segmented } from "theme.slint";

/// The latest game game mode found, and what it did.
export struct LastGameRow {
    /// Empty until a game was found since Vantix started.
    name: string,
    from: string,
    /// Empty while it's still running.
    to: string,
    priority: bool,
    cores: bool,
    /// The game refused the priority and core changes, as anti-cheats do.
    blocked: bool,
    services: int,
    wifi: bool,
    efficient: int,
}

/// A program ProBalance held back.
export struct ActionRow {
    time: string,
    name: string,
    /// How long, while `ongoing` is false.
    seconds: int,
    ongoing: bool,
}

/// A program on a game list, or one with a window open offered for them.
export struct GameEntry {
    /// File description for open programs; the exe name without .exe on the lists.
    title: string,
    exe: string,
}

/// ProBalance and the real-time game mode: what runs while Vantix is open.
export global Live {
    in-out property <bool> probalance;
    in-out property <bool> game-mode;
    in-out property <bool> priority;
    in-out property <bool> cores;
    in-out property <bool> eco;
    in-out property <bool> services;
    in-out property <bool> standby;
    in-out property <bool> wifi;
    in-out property <bool> gpu;

    /// 0 when every core is alike, 1 for Intel P-cores, 2 for the Ryzen V-Cache CCD.
    in property <int> cores-kind;
    in property <int> cores-preferred;
    in property <int> cores-total;
    in property <bool> has-wifi;
    in property <bool> has-hybrid-gpu;
    /// Windows 10 throttles only on some processors, so efficiency mode does less there.
    in property <bool> win10;

    /// Exe of the game being boosted, empty while there's none.
    in property <string> game;
    in property <int> restrained;
    in property <int> efficient;
    in property <LastGameRow> last;
    /// What ProBalance did lately, newest first.
    in property <[ActionRow]> actions;
    /// Exe names marked by hand as always a game, and never.
    in property <[GameEntry]> always;
    in property <[GameEntry]> never;

    /// The list the lists card shows: 0 always, 1 never.
    in-out property <int> list-tab;
    /// Programs with a window open are offered instead of the list.
    in-out property <bool> picking;
    in property <[GameEntry]> open-programs;

    callback changed();
    /// Picks an exe file for the always list (true) or the never list.
    callback add-game(bool);
    callback remove-game(bool, int);
    /// Fills open-programs and shows them.
    callback pick();
    callback add-open(bool, int);
    /// Puts the game being boosted on the never list, which ends the boost.
    callback not-a-game();
    /// Opens game-mode.log.
    callback open-log();
}

/// A program on a game list or offered for one: icon tile, name, exe and one action.
component NameRow inherits Rectangle {
    in property <string> icon;
    in property <color> tint;
    in property <string> title;
    in property <string> detail;
    in property <string> action-icon;
    in property <color> action-tint;
    /// The whole row does the action, not only its button.
    in property <bool> whole;
    callback action();

    height: 46px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.raised : transparent;

    touch := TouchArea {
        mouse-cursor: root.whole ? pointer : default;
        clicked => {
            if root.whole {
                root.action();
            }
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                background: root.tint.with-alpha(0.12);
                Icon {
                    data: root.icon;
                    tint: root.tint;
                    size: 16px;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.detail;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: root.action-icon;
                hover-tint: root.action-tint;
                clicked => { root.action(); }
            }
        }
    }
}

component LiveCard inherits Rectangle {
    in property <bool> on;

    height: content.preferred-height;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.on ? Theme.accent.with-alpha(0.35) : Theme.border;

    content := VerticalLayout {
        padding: 18px;
        padding-left: 20px;
        spacing: 10px;
        @children
    }
}

component Status inherits Text {
    color: Theme.accent;
    font-size: 12px;
    font-weight: 600;
    wrap: word-wrap;
}

component Option inherits Toggle {
    toggled => { Live.changed(); }
}

export component ProBalanceCard inherits LiveCard {
    on: Live.probalance;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text {
            text: @tr("ProBalance");
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Chip { text: @tr("Works while Vantix is open"); }
        }
    }
    Toggle {
        text: @tr("Hold back programs that hog the CPU");
        detail: @tr("When the CPU is nearly full, a background program taking a big share of it drops to a lower priority until it calms down, so what you're using stays responsive. Nothing is closed and the program in front is never touched.");
        checked <=> Live.probalance;
        toggled => { Live.changed(); }
    }
    if Live.probalance: Status {
        text: Live.restrained == 0 ? @tr("Watching. Nothing needs holding back right now.")
            : @tr("Holding back {n} program right now." | "Holding back {n} programs right now." % Live.restrained);
    }
    if Live.probalance && Live.actions.length > 0: VerticalLayout {
        spacing: 2px;
        Text {
            text: @tr("Latest actions");
            color: Theme.muted;
            font-size: 12px;
            font-weight: 600;
        }
        for action in Live.actions: HorizontalLayout {
            spacing: 10px;
            Text {
                text: action.time;
                color: Theme.muted;
                font-size: 12px;
            }
            Text {
                text: action.name;
                color: Theme.text;
                font-size: 12px;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: action.ongoing ? @tr("held back now")
                    : action.seconds < 60 ? @tr("held back for {} s", action.seconds)
                    : @tr("held back for {} min", Math.round(action.seconds / 60));
                color: Theme.muted;
                font-size: 12px;
            }
        }
    }
}

export component GameModeCard inherits LiveCard {
    on: Live.game-mode;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text {
            text: @tr("Real-time game mode");
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Chip { text: @tr("Works while Vantix is open"); }
        }
    }
    Toggle {
        text: @tr("Boost games automatically");
        detail: @tr("Vantix spots a game when it fills the screen for a few seconds, or in a window when Windows already knows it as a game, and puts everything back when the game closes.");
        checked <=> Live.game-mode;
        toggled => { Live.changed(); }
    }
    if Live.game-mode: HorizontalLayout {
        spacing: 12px;
        Status {
            horizontal-stretch: 1;
            vertical-alignment: center;
            text: Live.game == "" ? @tr("Waiting for a game.")
                : Live.efficient > 0 ? @tr("Boosting {}. Background programs in efficiency mode: {}.", Live.game, Live.efficient)
                : @tr("Boosting {}.", Live.game);
        }
        if Live.game != "": Button {
            text: @tr("Not a game");
            tall: 28px;
            clicked => { Live.not-a-game(); }
        }
        Button {
            text: @tr("Open log");
            tall: 28px;
            clicked => { Live.open-log(); }
        }
    }
    if Live.game-mode && Live.game != "" && Live.last.blocked: Text {
        color: Theme.muted;
        font-size: 12px;
        wrap: word-wrap;
        text: @tr("The game refused the priority change, likely its anti-cheat. The other boosts still run.");
    }
    if Live.game-mode && Live.game == "" && Live.last.name != "": Text {
        color: Theme.muted;
        font-size: 12px;
        wrap: word-wrap;
        text: @tr("Last game: {} from {} to {}.", Live.last.name, Live.last.from, Live.last.to)
            + (Live.last.priority ? " " + @tr("High priority.") : "")
            + (Live.last.blocked ? " " + @tr("The game refused the priority change, likely its anti-cheat.") : "")
            + (Live.last.cores ? " " + @tr("Kept on the fast cores.") : "")
            + (Live.last.services > 0 ? " " + @tr("{n} service paused." | "{n} services paused." % Live.last.services) : "")
            + (Live.last.wifi ? " " + @tr("Wi-Fi scans off.") : "")
            + (Live.last.efficient > 0
                ? " " + @tr("Up to {n} background program in efficiency mode." | "Up to {n} background programs in efficiency mode." % Live.last.efficient)
                : "");
    }

    if Live.game-mode: VerticalLayout {
        padding-left: 16px;
        spacing: 8px;

        Option {
            text: @tr("CPU and GPU priority for the game");
            detail: @tr("The game gets high CPU priority and the graphics card schedules its work first.");
            checked <=> Live.priority;
        }
        if Live.cores-kind != 0: Option {
            text: Live.cores-kind == 1 ? @tr("Keep the game on the P-cores") : @tr("Keep the game on the V-Cache cores");
            detail: Live.cores-kind == 1
                ? @tr("The game runs on the {} fast cores of {} and leaves the efficiency cores to the rest.", Live.cores-preferred, Live.cores-total)
                : @tr("The game runs on the {} cores of {} that sit next to the extra 3D cache, which most games prefer.", Live.cores-preferred, Live.cores-total);
            checked <=> Live.cores;
        }
        Option {
            text: @tr("Background programs in efficiency mode");
            detail: @tr("Launchers, browsers and updaters left in the background run on Windows' efficiency mode (EcoQoS). Controller and peripheral software, voice chat, recording, overlays and anti-cheats are left alone, and whatever you bring to the front runs at full speed.")
                + (Live.win10 ? " " + @tr("On Windows 10 it does less: Windows only slows them down on processors that support power throttling, mostly laptops.") : "");
            checked <=> Live.eco;
        }
        Option {
            text: @tr("Pause search indexing and update sharing");
            detail: @tr("Windows Search and Delivery Optimization stop while the game runs and start again after.");
            checked <=> Live.services;
        }
        Option {
            text: @tr("Clear the standby cache when free memory runs out");
            detail: @tr("Like ISLC: when less than 1 GB is free and the file cache holds more, it's emptied at once instead of page by page during the game.");
            checked <=> Live.standby;
        }
        if Live.has-wifi: Option {
            text: @tr("Stop Wi-Fi background scans");
            detail: @tr("Windows looks for networks about every minute even while connected, which shows up as a ping spike. The connection stays as it is.");
            checked <=> Live.wifi;
        }
        if Live.has-hybrid-gpu: Option {
            text: @tr("Dedicated graphics card for detected games");
            detail: @tr("Each game found is set to the dedicated GPU in Windows graphics settings, from its next start. A choice you already made there stays. Turning this off removes the ones Vantix set.");
            checked <=> Live.gpu;
        }
    }
}

/// The hand made lists, for what automatic detection gets wrong.
export component GameListsCard inherits LiveCard {
    property <bool> always: Live.list-tab == 0;
    property <[GameEntry]> names: self.always ? Live.always : Live.never;

    on: false;

    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: @tr("Your game lists");
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
            }
            Text {
                text: root.always ? @tr("Boosted whenever it's in front, in a window too.") : @tr("Never boosted, even in fullscreen.");
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Segmented {
                width: 290px;
                options: [@tr("Always a game ({})", Live.always.length), @tr("Never a game ({})", Live.never.length)];
                selected <=> Live.list-tab;
                changed => { Live.picking = false; }
            }
        }
    }

    Rectangle {
        height: panel.preferred-height;
        background: Theme.background;
        border-radius: Theme.radius-small;
        border-width: 1px;
        border-color: Theme.border;

        panel := VerticalLayout {
            padding: 6px;
            spacing: 2px;

            if Live.picking: HorizontalLayout {
                padding-left: 10px;
                Text {
                    height: 30px;
                    text: root.always ? @tr("Open now. Pick the game:") : @tr("Open now. Pick the program:");
                    color: Theme.muted;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            if Live.picking: VerticalLayout {
                spacing: 2px;
                for program[i] in Live.open-programs: NameRow {
                    icon: Icons.monitor;
                    tint: Theme.info;
                    title: program.title;
                    detail: program.exe;
                    action-icon: Icons.plus;
                    action-tint: Theme.accent;
                    whole: true;
                    action => { Live.add-open(root.always, i); }
                }
            }
            if Live.picking && Live.open-programs.length == 0: Text {
                height: 46px;
                text: @tr("No other program has a window open right now.");
                color: Theme.muted;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if !Live.picking: VerticalLayout {
                spacing: 2px;
                for entry[i] in root.names: NameRow {
                    icon: root.always ? Icons.gamepad : Icons.ban;
                    tint: root.always ? Theme.accent : Theme.muted;
                    title: entry.title;
                    detail: entry.exe;
                    action-icon: Icons.x;
                    action-tint: Theme.bad;
                    action => { Live.remove-game(root.always, i); }
                }
            }
            if !Live.picking && root.names.length == 0: VerticalLayout {
                padding: 14px;
                Text {
                    text: root.always
                        ? @tr("Nothing here yet. Vantix finds most games by itself; add one only when it's missed.")
                        : @tr("Nothing here yet. Add a program that goes fullscreen without being a game, like a video player.");
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        if Live.picking: Button {
            text: @tr("Browse for an .exe");
            icon: Icons.folder;
            tall: 32px;
            clicked => { Live.add-game(root.always); }
        }
        if Live.picking: Button {
            text: @tr("Cancel");
            tall: 32px;
            clicked => { Live.picking = false; }
        }
        if !Live.picking: Button {
            text: @tr("Add a program");
            icon: Icons.plus;
            tall: 32px;
            clicked => { Live.pick(); }
        }
    }
}
