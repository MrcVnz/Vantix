        @tr("Keys without delay (gaming Filter Keys)"),
        @tr("Stop Store apps in the background"),
        @tr("Telemetry to the minimum"),
        @tr("Clear the DNS cache"),
        @tr("Renew the IP address"),
        @tr("Reset the network stack"),
        @tr("Clear a set proxy"),
        @tr("Clear the ARP cache"),
        @tr("Sync the clock"),
        @tr("Reconnect the adapter"),
        @tr("Clean the hosts file"),
        @tr("Turn off IPv6 on the adapter"),
        @tr("Change the DNS servers"),
        @tr("Turn off Interrupt Moderation"),
        @tr("Turn off Energy Efficient Ethernet"),
        @tr("Turn on Receive Side Scaling"),
        @tr("Keep Windows from turning off the network adapter"),
        @tr("Wi-Fi at full power"),
        @tr("Prefer the 5 GHz Wi-Fi band"),
        @tr("Lowest Wi-Fi roaming"),
        @tr("Stop uploading updates to PCs on the internet"),
        @tr("Limit a program's upload"),
        @tr("Turn off Large Send Offload"),
        @tr("Turn off Flow Control"),
        @tr("Turn off Packet Coalescing"),
        @tr("Largest receive and send buffers"),
        @tr("Turn off LLMNR"),
        @tr("Turn off NetBIOS over TCP/IP"),
        @tr("DNS over HTTPS"),
        @tr("Don't let Windows turn off the keyboard and mouse"),
        @tr("Turn off Slow Keys and Bounce Keys"),
        @tr("Clean up the component store"),
        @tr("Stop creating 8.3 short names"),
    ];
    out property <[string]> details: [
        @tr("Deletes hiberfil.sys, a file sized from your RAM that only hibernation uses."),
        @tr("Windows keeps about 7 GB aside for updates. This gives that space back."),
        @tr("Stores the Windows files compressed and frees 2 to 4 GB. Takes 5 to 20 minutes."),
        @tr("NTFS stops writing the last access date every time a file is read. Less writing to the drive."),
        @tr("Tells your SSDs about all the free space at once. Windows already does this every week on its own."),
        @tr("Turns on the plan Windows keeps hidden for workstations: every CPU core stays awake at full clock, boost kicks in sooner and the link to the graphics card and NVMe drives stays at full power. Undo goes back to the plan you were using."),
        @tr("Keeps every CPU core awake while plugged in, so work never waits for a parked core to wake up."),
        @tr("Sets the minimum processor state to 100% while plugged in, so the clock never drops between bursts of work."),
        @tr("Lets the CPU go above its base clock sooner and more often while plugged in."),
        @tr("Stops the link to the graphics card and NVMe drives from dropping into low power states while plugged in."),
        @tr("Windows stops putting idle USB devices to sleep, which can cause mouse, headset or controller dropouts."),
        @tr("Memory integrity (HVCI) checks every driver inside a virtualized layer, which costs 5 to 10% in many games."),
        @tr("With 16 GB or more, Windows spends CPU time compressing memory it rarely needs to save."),
        @tr("The devices signal the CPU with a message instead of sharing an interrupt line with others, which cuts the delay before their work is handled. Only devices whose driver supports it are changed."),
        @tr("DirectX 10 and 11 games in windowed and borderless modes use the flip model: lower latency, plus VRR and Auto HDR. Takes effect when the game restarts."),
        @tr("Lets G-Sync and FreeSync work in games that don't support VRR in a window on their own. Takes effect when the game restarts."),
        @tr("Stops Xbox Game Bar from recording the last minutes of gameplay all the time."),
        @tr("Windows gives the game priority for CPU and GPU time and holds back Windows Update installs and notifications while you play."),
        @tr("The graphics card manages its own memory and work queue. Required for DLSS Frame Generation."),
        @tr("On Windows 11 a program asking for a 0.5 ms timer only gets it while its window is visible. This makes the request count for the whole system again, like before Windows 11."),
        @tr("Turns off Enhance pointer precision, so the same hand movement always moves the pointer the same distance, at any speed."),
        @tr("Pressing Shift five times, holding right Shift or holding Num Lock no longer pops up Sticky, Filter or Toggle Keys in the middle of a game. The features stay in Settings."),
        @tr("Sets the delay before a held key starts repeating to the shortest, 250 ms, and the repeat speed to the fastest, about 30 a second."),
        @tr("Turns on Filter Keys with no wait and no bounce time, so Filter Keys never delays or ignores a key, and makes a held key repeat after 150 ms, every 10 ms. That's past what the regular keyboard settings allow."),
        @tr("Microsoft Store apps no longer keep running after you close them."),
        @tr("Sets diagnostic data to the lowest level your Windows edition allows and turns off the service that sends it."),
        @tr("Windows forgets every name it looked up. Fixes a site that moved to a new address and still won't load on this PC."),
        @tr("Asks the router for the address lease again. Fixes a connection that shows no internet after the router restarted."),
        @tr("Puts Winsock and TCP/IP back to how Windows installs them. For a connection that nothing else fixes."),
        @tr("A proxy set by a VPN or malware that stayed on sends every request to an address that no longer answers. Clears the Windows and the machine-wide proxy."),
        @tr("Forgets the remembered address of the router and neighbors, for when the router was replaced or rebooted and the first packets go nowhere."),
        @tr("The PC asks the Windows time service to set the clock straight away. A clock minutes off breaks every HTTPS site with a certificate error."),
        @tr("Turns the connection off and on again, for a Wi-Fi link stuck on a bad decision or half a handshake that never finished."),
        @tr("Removes hosts lines that point Windows, Google, Apple, Cloudflare or Steam at an address set by hand, and keeps a copy beside the file to undo."),
        @tr("Windows prefers the newer internet protocol, and when its routing is half working every site waits for the IPv6 attempt to time out first. Only for the diagnosis that says IPv6 is the broken layer."),
        @tr("The connection in use asks the chosen service for every name, through its main and backup servers, and over IPv6 too when the connection has it. Takes effect at once."),
        @tr("The network card tells the CPU about each packet as it arrives instead of holding a few to report together. That saves up to a fraction of a millisecond per packet. The connection drops for a few seconds while the adapter restarts."),
        @tr("The cable link stops dozing between packets, so it never has to wake up before sending. Covers the standard setting and Realtek's Green Ethernet. The connection drops for a few seconds while the adapter restarts."),
        @tr("Incoming traffic is spread over several CPU cores instead of one, so a fast download can't max out a single core and slow down everything behind it. The connection drops for a few seconds while the adapter restarts."),
        @tr("Unticks \"Allow the computer to turn off this device to save power\", so the adapter doesn't drop off after the PC idles or wakes from sleep."),
        @tr("Turns off Wi-Fi power saving on battery too. Plugged in, Windows already runs Wi-Fi at full power. With power saving the adapter naps between packets, which shows up as ping spikes."),
        @tr("The Intel Wi-Fi card joins your router's 5 GHz band whenever it can, which is faster and less crowded than 2.4 GHz. The connection drops for a few seconds while the adapter restarts."),
        @tr("The Intel Wi-Fi card only looks for another access point when the signal is very weak. Each search stalls the connection for a moment. For PCs that stay in one place. The connection drops for a few seconds while the adapter restarts."),
        @tr("Windows is set to send updates to other PCs on the internet, which fills your upload and lags everything else. This keeps the sharing to your local network, the Windows default."),
        @tr("A Windows QoS policy holds the program's upload to half of what the Bufferbloat test measured, so it can't fill the line and raise everyone's ping. Downloads stay as they are: Windows can only limit what a program sends. Takes effect at once."),
        @tr("The network card cuts big uploads into packets by itself. Some Realtek and Intel cards send them in bursts that queue up in front of game traffic while something uploads. Off, the CPU does that work. The connection drops for a few seconds while the adapter restarts."),
        @tr("A busy router or switch can tell the network card to stop sending for a moment, and everything waits, game packets included. Off, the card keeps sending and the router drops what it can't take, which TCP handles better than a pause. The connection drops for a few seconds while the adapter restarts."),
        @tr("The network card holds incoming broadcast packets back and hands them over in groups, so the PC wakes less often. Off, they arrive as they come. The connection drops for a few seconds while the adapter restarts."),
        @tr("Room on the network card for packets that arrive or leave in a burst before the CPU gets to them. Some drivers ship well below what the card takes, and a full buffer drops packets. This sets both to the highest the driver lists. The connection drops for a few seconds while the adapter restarts."),
        @tr("Security, not speed. When a name isn't in DNS, Windows asks the whole local network who has it, and anyone can answer. On public Wi-Fi a device can answer for a name it doesn't own and collect your PC's sign-in hash."),
        @tr("Security, not speed. The older cousin of LLMNR: Windows answers and asks for names over broadcast, on every adapter. The same trick works on it, and it also tells the network your PC's name. Set on every adapter, so a VPN or a second card doesn't bring it back."),
        @tr("Privacy, not speed. The DNS service you picked on the DNS tab gets its lookups over HTTPS, so the network and your provider can't read or change which sites you look up. Windows 11 only."),
        @tr("Windows may put an idle keyboard or mouse to sleep, and the USB hub it hangs on, so the first key or movement after a pause can be lost while it wakes up. This unticks \"Allow the computer to turn off this device to save power\" in Device Manager for every keyboard, mouse and hub on the way. Takes effect at once."),
        @tr("Filter Keys is on with Slow Keys or Bounce Keys set: Windows ignores a key until it has been held a while, or when it's pressed again soon after. In a game that means late or lost presses. This sets both to zero and leaves the rest of Filter Keys as it is."),
        @tr("After each update Windows keeps the old versions of the system files it replaced, in WinSxS. This has DISM remove the ones newer updates made obsolete, the same cleanup Windows runs on its own schedule. Takes several minutes."),
        @tr("NTFS writes a second, DOS style name like PROGRA~1 for every new file, which costs a little time in folders with many files. The gain is small and mostly shows in huge folders. Names that already exist stay."),
    ];
    out property <[string]> notes: [
        @tr("The PC can no longer hibernate and Windows Fast Startup turns off with it."),
        @tr("With the drive almost full, Windows updates may fail to install."),
        @tr("Opening system programs uses a little more CPU."),
        @tr("Backup and cleanup tools that rely on this date no longer see when a file was opened."),
        "",
        @tr("More power draw, heat and fan noise, even at idle."),
        @tr("More power draw and heat while the PC sits idle."),
        @tr("The CPU runs hotter and draws more power even when idle."),
        @tr("More heat and fan noise under load."),
        @tr("A little more power draw while the PC sits idle."),
        @tr("USB devices draw power even when unused."),
        @tr("Removes a kernel protection against malicious drivers. Some anti-cheats require it to stay on."),
        @tr("Uses more RAM before Windows starts using the page file."),
        @tr("If a device acts up after the restart, undo this here."),
        "",
        "",
        @tr("Win+Alt+G, which saves what just happened, stops working."),
        "",
        @tr("Some older drivers stutter with it on."),
        @tr("Slightly more power use while some program asks for a fast timer."),
        "",
        "",
        "",
        @tr("Holding a key while typing repeats it very fast."),
        @tr("Those apps stop sending notifications and syncing until you open them."),
        @tr("Windows Insider and some feedback features stop working."),
        "",
        @tr("The connection can drop for a few seconds."),
        @tr("IP addresses and DNS servers set by hand are cleared, and VPN or firewall software may need to be reinstalled."),
        @tr("If a program needs its proxy on purpose, it stops reaching the internet until it's set again."),
        "",
        "",
        @tr("The adapter reconnects, so the connection drops for a few seconds."),
        @tr("Sites blocked on purpose in the hosts file load again. Undo puts every line back."),
        @tr("Addresses that only exist on IPv6 stop answering. Undo turns the protocol back on."),
        @tr("Quad9 blocks known malicious sites and AdGuard blocks ads, so a site can fail to load with them. On public Wi-Fi with a sign-in page, undo this if the page doesn't open."),
        @tr("More CPU time during big downloads, since every packet interrupts the CPU."),
        @tr("The network card draws a little more power."),
        "",
        @tr("A little more battery use while the PC sleeps."),
        @tr("Shorter battery life on Wi-Fi."),
        @tr("5 GHz reaches less far through walls. If the signal gets weak in some room, undo this."),
        @tr("Carried around, the laptop stays on a far access point longer before it switches."),
        "",
        @tr("That program uploads slower, so a backup or sync takes longer to finish."),
        @tr("A little more CPU use during big uploads."),
        @tr("On an old or overloaded switch, big transfers can lose a few more packets."),
        @tr("Slightly shorter battery life on laptops."),
        "",
        @tr("Devices found only by name on the local network, like some printers or NAS boxes, need their IP or a DNS entry."),
        @tr("Very old devices and Windows XP era shares that are browsed by name stop showing up."),
        @tr("No plain fallback: if the HTTPS address can't be reached, names stop resolving until you undo this. Some public Wi-Fi sign-in pages need it off."),
        @tr("A little more battery use on laptops."),
        @tr("If you set them on purpose to type more comfortably, undo this here."),
        @tr("Updates older than the latest ones can no longer be uninstalled."),
        @tr("Very old installers that depend on short names can fail."),
