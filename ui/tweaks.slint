import { Theme, Icons, Icon, Card, Button, Chip } from "theme.slint";
import { ListView, ScrollView } from "std-widgets.slint";

export enum TweakState {
    loading,
    off,
    /// Applied by Vantix, so it can be undone from the journal.
    on,
    /// Already in place without Vantix. It can still be turned off, as a change of its own.
    system,
    /// Was in place before Vantix and Vantix turned it off; undoing puts it back.
    reverted,
    unknown,
    busy,
    action,
    /// An action that already ran in this session.
    ran,
}

/// One tweak as shown on a section page. `index` points into the catalog and the texts below.
export struct TweakRow {
    index: int,
    state: TweakState,
    gain: int,
    cost: int,
    reboot: bool,
    /// Applied and waiting for a restart to take effect.
    pending: bool,
    /// Space it would free, when that's known up front.
    estimate: string,
    /// Space it freed when applied, measured on the drive.
    freed: string,
}

export struct ChangeRow {
    index: int,
    time: string,
    freed: string,
    pending: bool,
    /// Turned a tweak off rather than on.
    reset: bool,
}

export global Tweaks {
    in property <[TweakRow]> performance;
    in property <[TweakRow]> games;
    in property <[TweakRow]> internet;
    in property <[TweakRow]> input;
    in property <[TweakRow]> storage;
    in property <[TweakRow]> background;
    in property <[ChangeRow]> changes;
    in property <int> pending-count;
    in property <bool> busy;

    callback activate(int);
    callback undo(int);
    callback undo-all();
    callback reset(int);
    callback restart();
}

/// Texts in catalog order, see src/tweaks.rs.
export global TweakText {
    out property <[string]> titles: [
        @tr("Turn off hibernation"),
        @tr("Turn off reserved storage"),
        @tr("Compress Windows (CompactOS)"),
        @tr("Stop recording last access time"),
        @tr("Retrim SSDs"),
        @tr("Ultimate Performance power plan"),
        @tr("Turn off core parking"),
        @tr("Keep the CPU at full clock"),
        @tr("Aggressive processor boost"),
        @tr("Turn off PCI Express power saving"),
        @tr("Turn off USB selective suspend"),
        @tr("Turn off Memory integrity"),
        @tr("Turn off memory compression"),
        @tr("MSI mode for the graphics card and network adapter"),
        @tr("Optimizations for windowed games"),
        @tr("Variable refresh rate in windowed games"),
        @tr("Turn off Game Bar background recording"),
        @tr("Turn on Game Mode"),
        @tr("Hardware-accelerated GPU scheduling"),
        @tr("Global timer resolution"),
        @tr("Turn off mouse acceleration"),
        @tr("Turn off accessibility shortcuts"),
        @tr("Make key repeat as fast as Windows allows"),
        @tr("Keys without delay (gaming Filter Keys)"),
        @tr("Stop Store apps in the background"),
        @tr("Telemetry to the minimum"),
        @tr("Clear the DNS cache"),
        @tr("Renew the IP address"),
        @tr("Reset the network stack"),
    ];
    out property <[string]> details: [
        @tr("Deletes hiberfil.sys, a file sized from your RAM that only hibernation uses."),
        @tr("Windows keeps about 7 GB aside for updates. This gives that space back."),
        @tr("Stores the Windows files compressed and frees 2 to 4 GB. Takes 5 to 20 minutes."),
        @tr("NTFS stops writing the last access date every time a file is read. Less writing to the drive."),
        @tr("Tells your SSDs about all the free space at once. Windows already does this every week on its own."),
        @tr("Turns on the plan Windows keeps hidden for workstations: every CPU core stays awake at full clock, boost kicks in sooner and the link to the graphics card and NVMe drives stays at full power. Undo goes back to the plan you were using."),
        @tr("Keeps every CPU core awake while plugged in, so work never waits for a parked core to wake up."),
        @tr("Sets the minimum processor state to 100% while plugged in, so the clock never drops between bursts of work."),
        @tr("Lets the CPU go above its base clock sooner and more often while plugged in."),
        @tr("Stops the link to the graphics card and NVMe drives from dropping into low power states while plugged in."),
        @tr("Windows stops putting idle USB devices to sleep, which can cause mouse, headset or controller dropouts."),
        @tr("Memory integrity (HVCI) checks every driver inside a virtualized layer, which costs 5 to 10% in many games."),
        @tr("With 16 GB or more, Windows spends CPU time compressing memory it rarely needs to save."),
        @tr("The devices signal the CPU with a message instead of sharing an interrupt line with others, which cuts the delay before their work is handled. Only devices whose driver supports it are changed."),
        @tr("DirectX 10 and 11 games in windowed and borderless modes use the flip model: lower latency, plus VRR and Auto HDR. Takes effect when the game restarts."),
        @tr("Lets G-Sync and FreeSync work in games that don't support VRR in a window on their own. Takes effect when the game restarts."),
        @tr("Stops Xbox Game Bar from recording the last minutes of gameplay all the time."),
        @tr("Windows gives the game priority for CPU and GPU time and holds back Windows Update installs and notifications while you play."),
        @tr("The graphics card manages its own memory and work queue. Required for DLSS Frame Generation."),
        @tr("On Windows 11 a program asking for a 0.5 ms timer only gets it while its window is visible. This makes the request count for the whole system again, like before Windows 11."),
        @tr("Turns off Enhance pointer precision, so the same hand movement always moves the pointer the same distance, at any speed."),
        @tr("Pressing Shift five times, holding right Shift or holding Num Lock no longer pops up Sticky, Filter or Toggle Keys in the middle of a game. The features stay in Settings."),
        @tr("Sets the delay before a held key starts repeating to the shortest, 250 ms, and the repeat speed to the fastest, about 30 a second."),
        @tr("Turns on Filter Keys with no wait and no bounce time, so Filter Keys never delays or ignores a key, and makes a held key repeat after 150 ms, every 10 ms. That's past what the regular keyboard settings allow."),
        @tr("Microsoft Store apps no longer keep running after you close them."),
        @tr("Sets diagnostic data to the lowest level your Windows edition allows and turns off the service that sends it."),
        @tr("Windows forgets every name it looked up. Fixes a site that moved to a new address and still won't load on this PC."),
        @tr("Asks the router for the address lease again. Fixes a connection that shows no internet after the router restarted."),
        @tr("Puts Winsock and TCP/IP back to how Windows installs them. For a connection that nothing else fixes."),
    ];
    out property <[string]> notes: [
        @tr("The PC can no longer hibernate and Windows Fast Startup turns off with it."),
        @tr("With the drive almost full, Windows updates may fail to install."),
        @tr("Opening system programs uses a little more CPU."),
        @tr("Backup and cleanup tools that rely on this date no longer see when a file was opened."),
        "",
        @tr("More power draw, heat and fan noise, even at idle."),
        @tr("More power draw and heat while the PC sits idle."),
        @tr("The CPU runs hotter and draws more power even when idle."),
        @tr("More heat and fan noise under load."),
        @tr("A little more power draw while the PC sits idle."),
        @tr("USB devices draw power even when unused."),
        @tr("Removes a kernel protection against malicious drivers. Some anti-cheats require it to stay on."),
        @tr("Uses more RAM before Windows starts using the page file."),
        @tr("If a device acts up after the restart, undo this here."),
        "",
        "",
        @tr("Win+Alt+G, which saves what just happened, stops working."),
        "",
        @tr("Some older drivers stutter with it on."),
        @tr("Slightly more power use while some program asks for a fast timer."),
        "",
        "",
        "",
        @tr("Holding a key while typing repeats it very fast."),
        @tr("Those apps stop sending notifications and syncing until you open them."),
        @tr("Windows Insider and some feedback features stop working."),
        "",
        @tr("The connection can drop for a few seconds."),
        @tr("IP addresses and DNS servers set by hand are cleared, and VPN or firewall software may need to be reinstalled."),
    ];
    out property <[string]> levels: [@tr("None"), @tr("Low"), @tr("Medium"), @tr("High")];
}

/// "Gain: High" or "Cost: Medium", colored by how much it matters.
export component LevelTag inherits HorizontalLayout {
    in property <bool> is-cost;
    in property <int> level;
    property <color> tint: root.is-cost
        ? (root.level >= 3 ? Theme.bad : root.level == 2 ? Theme.warn : root.level == 1 ? Theme.muted : Theme.faint)
        : (root.level >= 2 ? Theme.accent : root.level == 1 ? Theme.text : Theme.faint);

    spacing: 6px;
    alignment: start;
    Text {
        text: root.is-cost ? @tr("Cost") : @tr("Gain");
        color: Theme.faint;
        font-size: 12px;
        vertical-alignment: center;
    }
    Text {
        text: TweakText.levels[root.level];
        color: root.tint;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

export component RebootChip inherits Chip {
    in property <bool> reboot;
    in property <bool> pending;
    text: root.pending ? @tr("Waiting for restart") : root.reboot ? @tr("Needs a restart") : @tr("No restart needed");
    tint: root.pending ? Theme.info : root.reboot ? Theme.warn : Theme.muted;
}

component TweakCard inherits Rectangle {
    in property <TweakRow> item;
    property <bool> busy: root.item.state == TweakState.busy;

    height: content.preferred-height;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.item.state == TweakState.on ? Theme.accent.with-alpha(0.35) : Theme.border;

    content := HorizontalLayout {
        padding: 18px;
        padding-left: 20px;
        spacing: 18px;

        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            alignment: center;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: TweakText.titles[root.item.index];
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if root.item.state == TweakState.on: VerticalLayout {
                    alignment: center;
                    Chip {
                        text: @tr("Applied");
                        tint: Theme.accent;
                    }
                }
                if root.item.state == TweakState.system: VerticalLayout {
                    alignment: center;
                    Chip { text: @tr("Already set in Windows"); }
                }
                if root.item.state == TweakState.reverted: VerticalLayout {
                    alignment: center;
                    Chip { text: @tr("Turned off by Vantix"); }
                }
                if root.item.state == TweakState.unknown: VerticalLayout {
                    alignment: center;
                    Chip {
                        text: @tr("Couldn't read the current state");
                        tint: Theme.warn;
                    }
                }
                if root.item.state != TweakState.system && root.item.state != TweakState.unknown: VerticalLayout {
                    alignment: center;
                    RebootChip {
                        reboot: root.item.reboot;
                        pending: root.item.pending;
                    }
                }
            }

            Text {
                text: TweakText.details[root.item.index];
                color: Theme.muted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 18px;
                alignment: start;
                LevelTag { level: root.item.gain; }
                LevelTag {
                    is-cost: true;
                    level: root.item.cost;
                }
                if root.item.freed != "": Text {
                    text: @tr("Freed {}", root.item.freed);
                    color: Theme.accent;
                    font-size: 12px;
                    font-weight: 600;
                }
                if root.item.freed == "" && root.item.estimate != "" && root.item.state == TweakState.off: Text {
                    text: @tr("Frees about {}", root.item.estimate);
                    color: Theme.accent;
                    font-size: 12px;
                    font-weight: 600;
                }
            }

            if TweakText.notes[root.item.index] != "": Text {
                text: TweakText.notes[root.item.index];
                color: Theme.warn;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            width: 150px;

            if root.item.state == TweakState.loading || root.busy: Text {
                text: root.busy ? @tr("Applying...") : @tr("Loading...");
                color: Theme.faint;
                horizontal-alignment: right;
            }
            if root.item.state == TweakState.off || root.item.state == TweakState.action || root.item.state == TweakState.ran: HorizontalLayout {
                alignment: end;
                Button {
                    text: root.item.state == TweakState.off ? @tr("Apply") : root.item.state == TweakState.ran ? @tr("Run again") : @tr("Run");
                    primary: root.item.state != TweakState.ran;
                    enabled: !Tweaks.busy;
                    clicked => { Tweaks.activate(root.item.index); }
                }
            }
            if root.item.state == TweakState.system: HorizontalLayout {
                alignment: end;
                Button {
                    text: @tr("Turn off");
                    enabled: !Tweaks.busy;
                    clicked => { Tweaks.reset(root.item.index); }
                }
            }
            if root.item.state == TweakState.on || root.item.state == TweakState.reverted: HorizontalLayout {
                alignment: end;
                Button {
                    text: @tr("Undo");
                    icon: Icons.history;
                    enabled: !Tweaks.busy;
                    clicked => { Tweaks.undo(root.item.index); }
                }
            }
        }
    }
}

/// Children go above the tweaks and scroll with them. A ScrollView rather than a ListView,
/// which only takes a single `for`; the lists are short enough not to need recycling.
export component TweakList inherits ScrollView {
    in property <[TweakRow]> rows;

    VerticalLayout {
        width: root.visible-width;
        alignment: start;
        @children
        for row in root.rows: VerticalLayout {
            padding-bottom: 12px;
            padding-right: 12px;
            TweakCard { item: row; }
        }
    }
}

/// Sits on top of every page while changes wait for a restart.
export component RebootBanner inherits Rectangle {
    property <bool> confirm;

    height: Tweaks.pending-count > 0 ? 52px : 0;
    visible: Tweaks.pending-count > 0;
    background: Theme.info.with-alpha(0.10);

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 24px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Icon {
                data: Icons.power;
                size: 16px;
                tint: Theme.info;
            }
        }
        Text {
            text: @tr("{n} change takes effect after a restart" | "{n} changes take effect after a restart" % Tweaks.pending-count);
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: root.confirm ? @tr("Click again to restart") : @tr("Restart now");
                tall: 34px;
                clicked => {
                    if root.confirm {
                        Tweaks.restart();
                    } else {
                        root.confirm = true;
                    }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.info.with-alpha(0.25);
    }

    Timer {
        interval: 4s;
        running: root.confirm;
        triggered => { root.confirm = false; }
    }
}

/// A page that only lists tweaks, for the sections that have nothing else.
export component SectionPage inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <[TweakRow]> rows;

    padding: 32px;
    padding-top: 26px;
    spacing: Theme.gap;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: root.title;
            color: Theme.text;
            font-family: Theme.display-font;
            font-size: 28px;
            font-weight: 700;
        }
        Text {
            text: root.subtitle;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }

    TweakList {
        vertical-stretch: 1;
        @children
        rows: root.rows;
    }
}
