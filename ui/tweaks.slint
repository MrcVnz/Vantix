    out property <[string]> levels: [@tr("None"), @tr("Low"), @tr("Medium"), @tr("High")];
}

/// "Gain: High" or "Cost: Medium", colored by how much it matters.
export component LevelTag inherits HorizontalLayout {
    in property <bool> is-cost;
    in property <int> level;
    property <color> tint: root.is-cost
        ? (root.level >= 3 ? Theme.bad : root.level == 2 ? Theme.warn : root.level == 1 ? Theme.muted : Theme.faint)
        : (root.level >= 2 ? Theme.accent : root.level == 1 ? Theme.text : Theme.faint);

    spacing: 6px;
    alignment: start;
    Text {
        text: root.is-cost ? @tr("Cost") : @tr("Gain");
        color: Theme.faint;
        font-size: 12px;
        vertical-alignment: center;
    }
    Text {
        text: TweakText.levels[root.level];
        color: root.tint;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

export component RebootChip inherits Chip {
    in property <bool> reboot;
    in property <bool> pending;
    text: root.pending ? @tr("Waiting for restart") : root.reboot ? @tr("Needs a restart") : @tr("No restart needed");
    tint: root.pending ? Theme.info : root.reboot ? Theme.warn : Theme.muted;
}

component TweakCard inherits Rectangle {
    in property <TweakRow> item;
    property <bool> busy: root.item.state == TweakState.busy;

    height: content.preferred-height;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.item.state == TweakState.on ? Theme.accent.with-alpha(0.35) : Theme.border;

    content := HorizontalLayout {
        padding: 18px;
        padding-left: 20px;
        spacing: 18px;

        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            alignment: center;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: TweakText.titles[root.item.index];
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if root.item.state == TweakState.on: VerticalLayout {
                    alignment: center;
                    Chip {
                        text: @tr("Applied");
                        tint: Theme.accent;
                    }
                }
                if root.item.state == TweakState.system: VerticalLayout {
                    alignment: center;
                    Chip { text: @tr("Already set in Windows"); }
                }
                if root.item.state == TweakState.reverted: VerticalLayout {
                    alignment: center;
                    Chip { text: @tr("Turned off by Vantix"); }
                }
                if root.item.state == TweakState.unknown: VerticalLayout {
                    alignment: center;
                    Chip {
                        text: @tr("Couldn't read the current state");
                        tint: Theme.warn;
                    }
                }
                if root.item.state == TweakState.recovery: VerticalLayout {
                    alignment: center;
                    Chip { text: @tr("Recovery needed"); tint: Theme.warn; }
                }
                if root.item.state != TweakState.system && root.item.state != TweakState.unknown: VerticalLayout {
                    alignment: center;
                    RebootChip {
                        reboot: root.item.reboot;
                        pending: root.item.pending;
                    }
                }
            }

            Text {
                text: TweakText.details[root.item.index];
                color: Theme.muted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 18px;
                alignment: start;
                LevelTag { level: root.item.gain; }
                LevelTag {
                    is-cost: true;
                    level: root.item.cost;
                }
                if root.item.freed != "": Text {
                    text: @tr("Freed {}", root.item.freed);
                    color: Theme.accent;
                    font-size: 12px;
                    font-weight: 600;
                }
                if root.item.freed == "" && root.item.estimate != "" && root.item.state == TweakState.off: Text {
                    text: @tr("Frees about {}", root.item.estimate);
                    color: Theme.accent;
                    font-size: 12px;
                    font-weight: 600;
                }
            }

            if TweakText.notes[root.item.index] != "": Text {
                text: TweakText.notes[root.item.index];
                color: Theme.warn;
                font-size: 12px;
                wrap: word-wrap;
            }

            if root.item.test-stage > 0: Text {
                text: root.item.test-stage == 1 ? @tr("Measuring ping during a download before the change, about 10 s...")
                    : root.item.test-stage == 2 ? @tr("Before: {} during a download. Apply to measure again.", root.item.test-before)
                    : root.item.test-stage == 3 ? @tr("Before: {} during a download. Measuring again after the change...", root.item.test-before)
                    : root.item.test-stage == 5 ? @tr("The test couldn't reach 1.1.1.1 or the speed test server.")
                    : root.item.test-verdict < 0 ? @tr("During a download: {} before, {} after. Better on your network.", root.item.test-before, root.item.test-after)
                    : root.item.test-verdict > 0 ? @tr("During a download: {} before, {} after. Worse on your network, undo it.", root.item.test-before, root.item.test-after)
                    : @tr("During a download: {} before, {} after. No difference beyond the usual noise, so undoing it costs nothing.", root.item.test-before, root.item.test-after);
                color: root.item.test-stage == 4 && root.item.test-verdict < 0 ? Theme.accent
                    : root.item.test-stage == 4 && root.item.test-verdict > 0 ? Theme.bad
                    : root.item.test-stage == 5 ? Theme.warn : Theme.info;
                font-size: 12px;
                font-weight: 600;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            width: 150px;

            if root.item.state == TweakState.loading || root.busy: Text {
                text: root.busy ? @tr("Applying...") : @tr("Loading...");
                color: Theme.faint;
                horizontal-alignment: right;
            }
            if root.item.state == TweakState.off || root.item.state == TweakState.action || root.item.state == TweakState.ran: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: root.item.state == TweakState.off ? @tr("Apply") : root.item.state == TweakState.ran ? @tr("Run again") : @tr("Run");
                        primary: root.item.state != TweakState.ran;
                        enabled: !Tweaks.busy && !Tweaks.testing;
                        clicked => { Tweaks.activate(root.item.index); }
                    }
                }
                if root.item.testable && root.item.state == TweakState.off: HorizontalLayout {
                    alignment: end;
                    Button {
                        text: @tr("Test first");
                        icon: Icons.gauge;
                        tall: 32px;
                        enabled: !Tweaks.busy && !Tweaks.testing;
                        clicked => { Tweaks.test(root.item.index); }
                    }
                }
            }
            if root.item.state == TweakState.system: HorizontalLayout {
                alignment: end;
                Button {
                    text: @tr("Turn off");
                    enabled: !Tweaks.busy;
                    clicked => { Tweaks.reset(root.item.index); }
                }
            }
            if root.item.state == TweakState.on || root.item.state == TweakState.reverted || root.item.state == TweakState.recovery: HorizontalLayout {
                alignment: end;
                Button {
                    text: @tr("Undo");
                    icon: Icons.history;
                    enabled: !Tweaks.busy;
                    clicked => { Tweaks.undo(root.item.index); }
                }
            }
        }
    }
}

/// Children go above the tweaks and scroll with them. A ScrollView rather than a ListView,
/// which only takes a single `for`; the lists are short enough not to need recycling.
export component TweakList inherits ScrollView {
    in property <[TweakRow]> rows;

    VerticalLayout {
        width: root.visible-width;
        alignment: start;
        @children
        for row in root.rows: VerticalLayout {
            padding-bottom: 12px;
            padding-right: 12px;
            TweakCard { item: row; }
        }
    }
}

/// The same cards for a page that already scrolls as a whole.
export component TweakColumn inherits VerticalLayout {
    in property <[TweakRow]> rows;

    @children
    for row in root.rows: VerticalLayout {
        padding-bottom: 12px;
        TweakCard { item: row; }
    }
}

/// Sits on top of every page while changes wait for a restart.
export component RebootBanner inherits Rectangle {
    property <bool> confirm;

    height: Tweaks.pending-count > 0 ? 52px : 0;
    visible: Tweaks.pending-count > 0;
    background: Theme.info.with-alpha(0.10);

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 24px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Icon {
                data: Icons.power;
                size: 16px;
                tint: Theme.info;
            }
        }
        Text {
            text: @tr("{n} change takes effect after a restart" | "{n} changes take effect after a restart" % Tweaks.pending-count);
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: root.confirm ? @tr("Click again to restart") : @tr("Restart now");
                tall: 34px;
                clicked => {
                    if root.confirm {
                        Tweaks.restart();
                    } else {
                        root.confirm = true;
                    }
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.info.with-alpha(0.25);
    }

    Timer {
        interval: 4s;
        running: root.confirm;
        triggered => { root.confirm = false; }
    }
}

/// A page that only lists tweaks, for the sections that have nothing else.
export component SectionPage inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <[TweakRow]> rows;

    padding: 32px;
    padding-top: 26px;
    spacing: Theme.gap;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: root.title;
            color: Theme.text;
            font-family: Theme.display-font;
            font-size: 28px;
            font-weight: 700;
        }
        Text {
            text: root.subtitle;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }

    TweakList {
        vertical-stretch: 1;
        @children
        rows: root.rows;
    }
}
