import { Theme, Icons, Icon, Card, Button, Chip } from "theme.slint";
import { ListView, ScrollView } from "std-widgets.slint";

export enum TweakState {
    loading,
    off,
    /// Applied by Vantix, so it can be undone from the journal.
    on,
    /// Already in place without Vantix. It can still be turned off, as a change of its own.
    system,
    /// Was in place before Vantix and Vantix turned it off; undoing puts it back.
    reverted,
    unknown,
    recovery,
    busy,
    action,
    /// An action that already ran in this session.
    ran,
}

/// One tweak as shown on a section page. `index` points into the catalog and the texts below.
export struct TweakRow {
    index: int,
    state: TweakState,
    gain: int,
    cost: int,
    reboot: bool,
    /// Applied and waiting for a restart to take effect.
    pending: bool,
    /// Space it would free, when that's known up front.
    estimate: string,
    /// Space it freed when applied, measured on the drive.
    freed: string,
    /// Has a "test it" button: ping under load before and after the change.
    testable: bool,
    /// 0 none, 1 measuring before, 2 waiting for the change, 3 measuring after, 4 done,
    /// 5 the test server or 1.1.1.1 didn't answer.
    test-stage: int,
    /// Average ping under load, before and after.
    test-before: string,
    test-after: string,
    /// -1 better, 0 within noise, 1 worse.
    test-verdict: int,
}

export struct ChangeRow {
    index: int,
    time: string,
    freed: string,
    pending: bool,
    /// Turned a tweak off rather than on.
    reset: bool,
}

export global Tweaks {
    in property <[TweakRow]> performance;
    in property <[TweakRow]> games;
    in property <[TweakRow]> internet;
    in property <[TweakRow]> network;
    in property <[TweakRow]> input;
    in property <[TweakRow]> storage;
    in property <[TweakRow]> background;
    in property <[ChangeRow]> changes;
    in property <int> pending-count;
    in property <bool> busy;

    callback activate(int);
    /// Measure, apply, measure again.
    callback test(int);
    /// A tweak test is measuring, so no other can start.
    in property <bool> testing;
    callback undo(int);
    callback undo-all();
    callback reset(int);
    callback restart();
}

/// Texts in catalog order, see src/tweaks.rs.
