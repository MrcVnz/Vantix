import { Theme, Icons, Icon, Card, Button, Chip } from "theme.slint";
import { LineEdit, ListView } from "std-widgets.slint";
import { Tweaks, TweakText, LevelTag, RebootChip } from "tweaks.slint";

export struct RestorePoint {
    sequence: int,
    description: string,
    created: string,
    /// Made by Vantix, so the app may delete it.
    own: bool,
    /// The one made before Vantix's first change.
    baseline: bool,
}

export global Protection {
    in property <bool> enabled;
    in property <bool> loading;
    in property <[RestorePoint]> points;
    in-out property <string> new-name;

    callback refresh();
    callback create();
    callback enable();
    callback open-system-restore();
    callback remove(int);
}

export enum JobState { idle, confirm, creating-point, applying, point-failed, done, failed }

/// Drives the modal progress sheet shared by every action that changes the system.
export global Job {
    in property <JobState> state;
    /// What is being created or applied, shown under the title.
    in property <string> subject;
    /// Error text from Windows on failures.
    in property <string> detail;
    /// Whether something waits to be applied after the restore point.
    in property <bool> has-change;
    in-out property <int> elapsed;

    // The tweak waiting for confirmation, see TweakRow.
    in property <int> tweak: -1;
    in property <bool> undo;
    in property <int> gain;
    in property <int> cost;
    in property <bool> reboot;
    /// Takes minutes, so the progress text says so.
    in property <bool> slow;
    /// Whether a restore point will be made first.
    in property <bool> with-point;
    /// The point made before Vantix's first change still exists and covers this one.
    in property <bool> baseline;
    /// System Restore is off, so there won't be a point.
    in property <bool> protection-off;
    /// Free space a finished change gave back.
    in property <string> freed;

    callback dismiss();
    callback confirm();
    callback proceed-without-point();
}

export component JobSheet inherits Rectangle {
    property <bool> busy: Job.state == JobState.creating-point || Job.state == JobState.applying;
    property <bool> failed: Job.state == JobState.point-failed || Job.state == JobState.failed;

    visible: Job.state != JobState.idle;
    background: #000000b0;

    // Swallows clicks so nothing underneath reacts while the sheet is up.
    TouchArea {}

    Timer {
        interval: 1s;
        running: root.busy;
        triggered => { Job.elapsed += 1; }
    }

    Rectangle {
        width: 440px;
        height: content.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border-strong;

        content := VerticalLayout {
            padding: 26px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 14px;
                alignment: start;

                Rectangle {
                    width: 42px;
                    height: 42px;
                    border-radius: 12px;
                    background: (root.failed ? Theme.bad : Theme.accent).with-alpha(0.12);
                    Icon {
                        data: root.failed ? Icons.alert : Job.state == JobState.done ? Icons.check
                            : Job.state == JobState.confirm && Job.undo ? Icons.history : Icons.shield;
                        size: 20px;
                        tint: root.failed ? Theme.bad : Theme.accent;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: Job.state == JobState.confirm
                                ? (Job.undo && Job.tweak < 0 ? @tr("Undo every change?") : Job.undo ? @tr("Undo this change?") : @tr("Apply this change?"))
                            : Job.state == JobState.creating-point ? @tr("Creating a restore point")
                            : Job.state == JobState.applying ? @tr("Applying changes")
                            : Job.state == JobState.point-failed ? @tr("Couldn't create the restore point")
                            : Job.state == JobState.done ? @tr("Done")
                            : @tr("Something went wrong");
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Text {
                        text: Job.subject;
                        color: Theme.muted;
                        overflow: elide;
                    }
                }
            }

            if Job.state == JobState.confirm: VerticalLayout {
                spacing: 12px;
                if !Job.undo: HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    LevelTag { level: Job.gain; }
                    LevelTag {
                        is-cost: true;
                        level: Job.cost;
                    }
                    RebootChip { reboot: Job.reboot; }
                }
                if !Job.undo && Job.tweak >= 0 && TweakText.notes[Job.tweak] != "": Text {
                    text: TweakText.notes[Job.tweak];
                    color: Theme.warn;
                    wrap: word-wrap;
                }
                Text {
                    text: Job.undo ? @tr("Puts back how it was before Vantix changed it.")
                        : Job.with-point ? @tr("This is the first change, so Vantix creates a restore point first.")
                        : Job.baseline ? @tr("The restore point made before Vantix's first change still covers this one, and Vantix keeps its own record to undo it.")
                        : Job.protection-off ? @tr("System protection is off, so there won't be a restore point. Vantix still keeps its own record to undo this.")
                        : @tr("Nothing to back up for this one, it runs right away.");
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }

            if root.busy: VerticalLayout {
                spacing: 10px;
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.raised;
                    clip: true;
                    Rectangle {
                        width: parent.width * 0.35;
                        x: (1 - cos(animation-tick() / 4ms * 1deg)) / 2 * (parent.width - self.width);
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }
                HorizontalLayout {
                    Text {
                        text: Job.state == JobState.creating-point
                            ? @tr("This can take up to two minutes. Keep the PC on.")
                            : Job.slow ? @tr("This one takes several minutes. You can keep using the PC.")
                            : @tr("Almost there.");
                        color: Theme.muted;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: Job.elapsed + " s";
                        color: Theme.faint;
                    }
                }
            }

            if Job.state == JobState.done && Job.freed != "": Text {
                text: @tr("Freed {}", Job.freed);
                color: Theme.accent;
                font-weight: 600;
            }

            if Job.state == JobState.done && Job.reboot: Text {
                text: @tr("Takes effect after a restart.");
                color: Theme.muted;
                wrap: word-wrap;
            }

            if (root.failed || Job.state == JobState.done) && Job.detail != "": Text {
                text: Job.detail;
                color: Theme.muted;
                wrap: word-wrap;
            }

            if Job.state == JobState.point-failed && Job.has-change: Text {
                text: @tr("You can still apply the change without a restore point. Vantix keeps its own record to undo it.");
                color: Theme.muted;
                wrap: word-wrap;
            }

            if !root.busy: HorizontalLayout {
                alignment: end;
                spacing: 10px;
                Button {
                    text: Job.state == JobState.confirm || (Job.state == JobState.point-failed && Job.has-change) ? @tr("Cancel") : @tr("Close");
                    clicked => { Job.dismiss(); }
                }
                if Job.state == JobState.confirm: Button {
                    text: Job.undo ? @tr("Undo") : @tr("Apply");
                    primary: true;
                    clicked => { Job.confirm(); }
                }
                if Job.state == JobState.point-failed && Job.has-change: Button {
                    text: @tr("Apply without a restore point");
                    primary: true;
                    clicked => { Job.proceed-without-point(); }
                }
            }
        }
    }
}

component PointRow inherits HorizontalLayout {
    in property <RestorePoint> point;
    property <bool> confirm;

    padding-top: 6px;
    padding-bottom: 6px;
    padding-right: 14px;
    spacing: 12px;
    min-height: 44px;

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.point.description;
            color: Theme.text;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: root.point.created;
                color: Theme.faint;
                font-size: 12px;
            }
            if root.point.baseline: Text {
                text: "· " + @tr("Before the first change");
                color: Theme.accent;
                font-size: 12px;
                overflow: elide;
            }
        }
    }
    Text {
        text: "#" + root.point.sequence;
        color: Theme.faint;
        font-size: 12px;
        vertical-alignment: center;
    }
    // Same width on every row and in every language, so nothing shifts on the second click.
    VerticalLayout {
        alignment: center;
        width: 132px;
        if root.point.own: Button {
            text: root.confirm ? @tr("Confirm") : @tr("Delete");
            icon: Icons.trash;
            tall: 32px;
            danger: root.confirm;
            enabled: !Protection.loading;
            clicked => {
                if root.confirm {
                    root.confirm = false;
                    Protection.remove(root.point.sequence);
                } else {
                    root.confirm = true;
                }
            }
        }
    }

    Timer {
        interval: 4s;
        running: root.confirm;
        triggered => { root.confirm = false; }
    }
}

export component ProtectionPage inherits VerticalLayout {
    init => { Protection.refresh(); }

    padding: 32px;
    padding-top: 26px;
    spacing: Theme.gap;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: @tr("Protection");
            color: Theme.text;
            font-family: Theme.display-font;
            font-size: 28px;
            font-weight: 700;
        }
        Text {
            text: @tr("Windows restore points and the changes Vantix made.");
            color: Theme.muted;
        }
    }

    HorizontalLayout {
        spacing: Theme.gap;

        Card {
            title: @tr("System protection");
            icon: Icons.shield;
            width: 380px;

            HorizontalLayout {
                Text {
                    text: @tr("Restore points on the Windows drive");
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Chip {
                        text: Protection.enabled ? @tr("On") : @tr("Off");
                        tint: Protection.enabled ? Theme.accent : Theme.bad;
                    }
                }
            }

            Text {
                text: Protection.enabled
                    ? @tr("Vantix creates a point automatically before its first system change.")
                    : @tr("Without it Vantix can't create restore points. Turning it on reserves a small part of the drive.");
                color: Theme.muted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                if !Protection.enabled: Button {
                    text: @tr("Turn on");
                    primary: true;
                    clicked => { Protection.enable(); }
                }
                Button {
                    text: @tr("Open System Restore");
                    icon: Icons.external;
                    clicked => { Protection.open-system-restore(); }
                }
            }
        }

        Card {
            title: @tr("Create a restore point now");
            icon: Icons.plus;
            horizontal-stretch: 1;

            Text {
                text: @tr("Useful before installing drivers or trying something risky.");
                color: Theme.muted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;
                LineEdit {
                    placeholder-text: @tr("Name (optional)");
                    text <=> Protection.new-name;
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Create");
                    icon: Icons.shield;
                    primary: true;
                    enabled: Protection.enabled;
                    clicked => { Protection.create(); }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: Theme.gap;
        vertical-stretch: 1;

        Card {
            title: @tr("Restore points");
            icon: Icons.history;
            horizontal-stretch: 1;

            if Protection.points.length == 0: Text {
                text: Protection.loading ? @tr("Loading...") : @tr("No restore points yet.");
                color: Theme.faint;
                vertical-stretch: 1;
            }

            if Protection.points.length > 0: ListView {
                vertical-stretch: 1;
                for point in Protection.points: PointRow { point: point; }
            }
        }

        Card {
            title: @tr("Changes made by Vantix");
            icon: Icons.layers;
            width: 380px;

            if Tweaks.changes.length == 0: Text {
                text: @tr("Nothing changed yet. Every tweak you apply shows up here with an option to undo it.");
                color: Theme.faint;
                wrap: word-wrap;
                vertical-stretch: 1;
            }

            if Tweaks.changes.length > 0: ListView {
                vertical-stretch: 1;
                for change in Tweaks.changes: HorizontalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    padding-right: 12px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: TweakText.titles[change.index];
                            color: Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: change.pending ? change.time + " · " + @tr("Waiting for restart")
                                : change.freed != "" ? change.time + " · " + @tr("Freed {}", change.freed)
                                : change.time;
                            color: change.pending ? Theme.info : Theme.faint;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                    Button {
                        text: @tr("Undo");
                        tall: 32px;
                        enabled: !Tweaks.busy;
                        clicked => { Tweaks.undo(change.index); }
                    }
                }
            }

            if Tweaks.changes.length > 1: HorizontalLayout {
                alignment: end;
                Button {
                    text: @tr("Undo all");
                    icon: Icons.history;
                    enabled: !Tweaks.busy;
                    clicked => { Tweaks.undo-all(); }
                }
            }
        }
    }
}
