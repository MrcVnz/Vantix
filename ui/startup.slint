import { Theme, Card, Toggle, Segmented, Button } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { Tweaks, TweakList } from "tweaks.slint";

/// One program that starts with Windows.
export struct StartupRow {
    name: string,
    publisher: string,
    all-users: bool,
    enabled: bool,
    /// 0 a Run key or Startup folder, 1 a Store app, 2 a scheduled task.
    kind: int,
    /// Set by policy, so the switch is greyed out.
    locked: bool,
    /// The program it starts is gone; the row offers to remove it.
    missing: bool,
    /// RAM its processes use right now, empty when it isn't running.
    memory: string,
}

export global Startup {
    in property <[StartupRow]> rows;
    in property <int> enabled-count;
    in property <bool> loaded;
    /// Startup apps or tweaks, kept while the page itself comes and goes.
    in-out property <int> tab;

    callback refresh();
    callback toggled(int, bool);
    callback remove(int);
}

export component BackgroundPage inherits VerticalLayout {
    padding: 32px;
    padding-top: 26px;
    spacing: Theme.gap;

    // The list is read again every time the page opens, so the RAM figures are current.
    init => { Startup.refresh(); }

    HorizontalLayout {
        spacing: Theme.gap;
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: @tr("Background");
                color: Theme.text;
                font-family: Theme.display-font;
                font-size: 28px;
                font-weight: 700;
            }
            Text {
                text: Startup.tab == 0
                    ? @tr("Programs that open on their own when you sign in. Turning one off doesn't uninstall or close it.")
                    : @tr("What keeps running when you're not using it.");
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            Segmented {
                width: 290px;
                options: [@tr("Startup apps"), @tr("Tweaks")];
                selected <=> Startup.tab;
            }
        }
    }

    if Startup.tab == 1: TweakList {
        vertical-stretch: 1;
        rows: Tweaks.background;
    }

    if Startup.tab == 0: Card {
        vertical-stretch: 1;
        pad: 14px;

        Text {
            x: 6px;
            text: !Startup.loaded ? @tr("Loading...")
                : Startup.rows.length == 0 ? @tr("No apps start with Windows.")
                : @tr("{} of {} start with Windows. Changes count from the next sign-in.", Startup.enabled-count, Startup.rows.length);
            color: Theme.text;
            font-weight: 600;
        }

        ListView {
            vertical-stretch: 1;
            for row[i] in Startup.rows: HorizontalLayout {
                padding-left: 6px;
                padding-right: 14px;
                if !row.missing: Toggle {
                    text: row.name;
                    detail: (row.publisher != "" ? row.publisher + "  ·  " : "")
                        + (row.kind == 1 ? @tr("Store app") : row.kind == 2 ? @tr("Scheduled task")
                            : row.all-users ? @tr("All users") : @tr("This user"))
                        + (row.locked ? "  ·  " + @tr("Set by your organization") : "")
                        + (row.memory != "" ? "  ·  " + @tr("{} in use now", row.memory) : "");
                    enabled: !row.locked;
                    checked: row.enabled;
                    toggled(on) => { Startup.toggled(i, on); }
                }
                if row.missing: HorizontalLayout {
                    spacing: 16px;
                    min-height: 48px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: row.name;
                            color: Theme.text;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("The program it starts isn't there any more.");
                            color: Theme.warn;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: @tr("Remove");
                            tall: 32px;
                            clicked => { Startup.remove(i); }
                        }
                    }
                }
            }
        }
    }
}
