import { Theme, Icons, Icon, Card, Button, Chip, Segmented } from "theme.slint";
import { LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Tweaks, TweakList, TweakColumn } from "tweaks.slint";

/// One ping target. Times come formatted, empty while there's no answer yet.
export struct PingRow {
    label: string,
    address: string,
    now: string,
    average: string,
    jitter: string,
    loss: string,
    /// SVG paths on a 59 x 40 box: the round trips, and a mark for each lost ping.
    line: string,
    lost: string,
    /// 0 pinging, 1 looking up the address, 2 no address.
    state: int,
    /// Index among the hosts the user added, -1 for the built-in targets.
    host: int,
}

export struct BloatResult {
    grade: string,
    idle: string,
    down-speed: string,
    down-ping: string,
    down-added: string,
    down-lost: int,
    up-speed: string,
    up-ping: string,
    up-added: string,
    up-lost: int,
    data: string,
}

export struct DnsRow {
    name: string,
    address: string,
    cached: string,
    uncached: string,
    failed: int,
    sent: int,
    current: bool,
    best: bool,
    /// A public service Vantix can set.
    provider: bool,
    /// In use because Vantix set it, so it can be undone here.
    vantix: bool,
}

export struct DiagRow {
    /// 0 queued, 1 running, 2 ok, 3 failed, 4 skipped, 5 warning.
    state: int,
    name: string,
    /// Empty until the layer had something to say.
    detail: string,
    /// Catalog index of the repair, -1 when the layer has none.
    fix: int,
    /// DNS failed: the DNS tab can pick servers that answer.
    go-dns: bool,
}

export struct UsageRow {
    name: string,
    /// The exe name, as upload limits match it.
    program: string,
    /// The upload limit Vantix set, empty when there's none.
    limit: string,
    can-limit: bool,
    down: string,
    up: string,
    total-down: string,
    total-up: string,
    /// Of the busiest program's rate, for the bar.
    share: float,
}

export global Net {
    /// Kept while the page comes and goes. Ping runs only on tab 0, the traffic count on 3.
    in-out property <int> tab;
    /// Adapter and router of the connection in use, empty when there is none.
    in property <string> adapter;
    in property <string> gateway;

    in property <[PingRow]> pings;
    /// 0 too early to tell, 1 stable, 2 trouble inside the home network, 3 past the router.
    in property <int> verdict;
    in-out property <string> new-host;
    callback add-host();
    callback remove-host(int);

    /// 0 not run, 1 running, 2 done, 3 1.1.1.1 doesn't answer pings, 4 test server unreachable.
    in property <int> bloat-state;
    /// 0 idle, 1 download, 2 upload.
    in property <int> bloat-phase;
    in property <float> bloat-progress;
    in property <string> bloat-ping;
    in property <string> bloat-speed;
    in property <BloatResult> bloat;
    callback run-bloat();

    in property <bool> dns-running;
    in property <[DnsRow]> dns;
    /// 0 not run, 1 the current DNS is the fastest, 2 another one is faster, 3 the current
    /// one missed queries.
    in property <int> dns-verdict;
    in property <string> dns-best;
    in property <string> dns-gain;
    in property <int> dns-missed;
    /// The connection is cable, Wi-Fi or PPPoE, whose DNS Vantix can change.
    in property <bool> dns-settable;
    callback run-dns();
    /// Row index into `dns`.
    callback use-dns(int);
    callback undo-dns();

    in property <[UsageRow]> usage;
    in property <bool> usage-failed;
    /// A bufferbloat test measured the upload, which limits are set from.
    in property <bool> upload-known;
    callback limit-upload(string);
    callback remove-limit(string);

    /// Layers of the connection test: what each one came back as, live while it walks.
    in property <[DiagRow]> diagnose;
    /// 0 never run, 1 running, 2 all green, 3 one layer failed, 4 works with warnings.
    in property <int> diag-state;
    /// What broke, in one line, see `diag-summary`. 0 when nothing did.
    in property <int> diag-cause;
    callback run-diagnose();
    /// Catalog index of the repair for a failed layer.
    callback fix-diag(int);
    /// Shows the DNS tab, for DNS failures.
    callback go-dns();
    /// Layer names by index, translated here where @tr works.
    pure callback diag-name(int) -> string;
    diag-name(i) => [@tr("Adapter link"), @tr("IP address"), @tr("Router"), @tr("DNS"), @tr("Reach"), @tr("HTTPS"), @tr("Internet icon"), @tr("Proxy"), @tr("hosts file"), @tr("VPN leftovers"), @tr("IPv6")][i];
    /// What a layer said, by the code main.rs gives each `net::Detail`, with up to two
    /// values already formatted.
    pure callback diag-text(int, string, string) -> string;
    diag-text(code, a, b) => [
        "",
        @tr("cable"),
        @tr("Wi-Fi"),
        @tr("no connected adapter"),
        @tr("the adapter reports no link: cable out or Wi-Fi off"),
        a,
        @tr("no IPv4 address on the adapter"),
        @tr("169.254 address: the router's DHCP never answered"),
        @tr("best of 3: {}", a),
        @tr("answers ARP, blocks ping"),
        @tr("no answer from the router at {}", a),
        @tr("no router on this connection"),
        @tr("{} answered in {}", a, b),
        @tr("no DNS server set"),
        @tr("your DNS servers don't answer, 1.1.1.1 does in {}", a),
        @tr("not checked: not even 1.1.1.1 answers, so the next layer tells"),
        @tr("ping to 1.1.1.1: {}", a),
        @tr("TCP 443 to 1.1.1.1: {}", a),
        @tr("1.1.1.1 doesn't answer, not even on TCP 443"),
        @tr("answered"),
        @tr("answered, clock within {} s", a),
        @tr("answered, but the clock is {} ahead", a),
        @tr("answered, but the clock is {} behind", a),
        @tr("fails: a sign-in page answers instead"),
        @tr("fails, and the clock is {} ahead: the likely cause", a),
        @tr("fails, and the clock is {} behind: the likely cause", a),
        @tr("fails, and a proxy is set: the likely cause"),
        @tr("the secure connection fails"),
        @tr("Windows agrees there is internet"),
        @tr("a sign-in page is intercepting the connection"),
        @tr("works, but its name points to {}: something rewrites DNS answers", a),
        @tr("not checked: the probe got no answer"),
        @tr("no proxy set"),
        @tr("a proxy is set, and programs go through it"),
        @tr("auto-detect found a setup script at {}", a),
        @tr("{} entries, none in the way", a),
        @tr("entries sending everyday sites elsewhere: {} of {}", a, b),
        @tr("no leftover VPN adapters"),
        @tr("adapters left by a removed VPN: {}", a),
        @tr("reaches 1.1.1.1 over IPv6"),
        @tr("on, but goes nowhere: programs wait before falling back to IPv4"),
        @tr("not checked: no IPv6 on this connection"),
        @tr("not checked: IPv4 is down too, so this can't be told apart"),
        @tr("not checked: an earlier layer failed"),
        @tr("not checked: could not test here"),
    ][code];
    /// The one line under the title after a failure, by `diag-cause`.
    pure callback diag-summary(int) -> string;
    diag-summary(cause) => [
        "",
        @tr("The adapter has no link."),
        @tr("The PC didn't get an address from the router."),
        @tr("The router doesn't answer."),
        @tr("DNS doesn't answer, so sites can't be found by name."),
        @tr("Nothing past the router answers: the internet itself is down."),
        @tr("Secure sites fail to load."),
        @tr("A sign-in page is intercepting the connection."),
        @tr("The clock is wrong, and secure sites fail because of it."),
        @tr("Secure sites fail, and a proxy is the likely cause."),
    ][cause];
}

component Heading inherits Text {
    color: Theme.faint;
    font-size: 11.5px;
    font-weight: 600;
}

component Value inherits Text {
    color: Theme.text;
    font-weight: 600;
    horizontal-alignment: right;
    vertical-alignment: center;
}

/// Round trips over the last minute, on a 59 x 40 box. Path coordinates are integers,
/// see main.rs.
component Spark inherits Rectangle {
    in property <string> line;
    in property <string> lost;

    height: 40px;
    border-radius: 6px;
    background: Theme.background;

    if root.lost != "": Path {
        width: 100%;
        height: 100%;
        commands: root.lost;
        viewbox-width: 59;
        viewbox-height: 40;
        fit: fill;
        stroke: Theme.bad.with-alpha(0.7);
        stroke-width: 1.5px;
        fill: transparent;
    }
    if root.line != "": Path {
        width: 100%;
        height: 100%;
        commands: root.line;
        viewbox-width: 59;
        viewbox-height: 40;
        fit: fill;
        stroke: Theme.accent;
        stroke-width: 1.5px;
        stroke-line-join: round;
        fill: transparent;
    }
}

component PingItem inherits HorizontalLayout {
    in property <PingRow> item;

    spacing: 16px;
    padding-left: 6px;
    padding-right: 14px;
    height: 58px;

    VerticalLayout {
        width: 170px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.item.label != "" ? root.item.label : @tr("Router");
            color: Theme.text;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.item.state == 1 ? @tr("Looking up...")
                : root.item.state == 2 ? (root.item.host < 0 ? @tr("No gateway found") : @tr("Host not found"))
                : root.item.address;
            color: root.item.state == 2 ? Theme.warn : Theme.muted;
            font-size: 12px;
            overflow: elide;
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Spark {
            line: root.item.line;
            lost: root.item.lost;
        }
    }
    Value { width: 64px; text: root.item.now; }
    Value { width: 64px; text: root.item.average; }
    Value { width: 64px; text: root.item.jitter; }
    Value {
        width: 52px;
        text: root.item.loss;
        color: root.item.loss != "" && root.item.loss != "0%" ? Theme.bad : Theme.text;
    }
    Rectangle {
        width: 28px;
        if root.item.host >= 0: Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: remove.has-hover ? Theme.hover : transparent;
            Icon {
                data: Icons.x;
                size: 14px;
                tint: Theme.muted;
            }
            remove := TouchArea {
                mouse-cursor: pointer;
                clicked => { Net.remove-host(root.item.host); }
            }
        }
    }
}

component PingTab inherits Card {
    pad: 14px;

    Text {
        x: 6px;
        text: Net.verdict == 1 ? @tr("Stable: no loss and little jitter, both to the router and past it.")
            : Net.verdict == 2 ? @tr("The trouble is inside your home: even the router answers late or not at all. On Wi-Fi, get closer to the router, move to 5 GHz or use a cable.")
            : Net.verdict == 3 ? @tr("The router answers fine, so the loss or jitter comes from past it: your provider or the route to the server.")
            : @tr("Pings each target once a second while this tab is open.");
        color: Net.verdict == 1 ? Theme.accent : Net.verdict >= 2 ? Theme.warn : Theme.muted;
        font-weight: Net.verdict == 0 ? 400 : 600;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: 16px;
        padding-left: 6px;
        padding-right: 14px;
        Heading { width: 170px; text: @tr("Target"); }
        Heading { horizontal-stretch: 1; text: @tr("Last minute"); }
        Heading { width: 64px; text: @tr("Now"); horizontal-alignment: right; }
        Heading { width: 64px; text: @tr("Average"); horizontal-alignment: right; }
        Heading { width: 64px; text: @tr("Jitter"); horizontal-alignment: right; }
        Heading { width: 52px; text: @tr("Loss"); horizontal-alignment: right; }
        Rectangle { width: 28px; }
    }

    ListView {
        vertical-stretch: 1;
        for row in Net.pings: PingItem { item: row; }
    }

    HorizontalLayout {
        spacing: 10px;
        padding-left: 6px;
        padding-right: 6px;
        LineEdit {
            placeholder-text: @tr("Add a game server or site, by name or IP");
            text <=> Net.new-host;
            horizontal-stretch: 1;
            accepted => { Net.add-host(); }
        }
        Button {
            text: @tr("Add");
            icon: Icons.plus;
            enabled: Net.new-host != "" && Net.pings.length < 7;
            clicked => { Net.add-host(); }
        }
    }
}

component Figure inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <color> detail-color: Theme.muted;

    spacing: 2px;
    Heading { text: root.label; }
    Text {
        text: root.value;
        color: Theme.text;
        font-size: 20px;
        font-weight: 700;
    }
    Text {
        text: root.detail;
        color: root.detail-color;
        font-size: 12px;
    }
}

component BloatTab inherits ScrollView {
    property <color> grade-color: Net.bloat.grade == "A" ? Theme.accent
        : Net.bloat.grade == "B" ? Theme.info
        : Net.bloat.grade == "C" ? Theme.warn : Theme.bad;

    VerticalLayout {
        width: root.visible-width;
        alignment: start;
        spacing: Theme.gap;

        Card {
            title: @tr("Ping under load");
            icon: Icons.activity;

            Text {
                text: @tr("Measures the ping to Cloudflare at rest, then while the line downloads and uploads at full speed. A router that queues too much turns every download in the house into lag in games and calls. That's bufferbloat.");
                color: Theme.muted;
                wrap: word-wrap;
            }
            Text {
                text: @tr("Takes about 20 seconds and uses as much data as your line moves in 16 seconds at full speed, over 1 GB on fiber. Avoid it on mobile data. Pause downloads and streams first, or they count as bloat.");
                color: Theme.warn;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 14px;
                Button {
                    text: Net.bloat-state == 1 ? @tr("Testing...") : Net.bloat-state == 0 ? @tr("Start test") : @tr("Test again");
                    icon: Icons.zap;
                    primary: Net.bloat-state != 1;
                    enabled: Net.bloat-state != 1;
                    clicked => { Net.run-bloat(); }
                }
                if Net.bloat-state == 1: Text {
                    text: (Net.bloat-phase == 0 ? @tr("Ping at rest") : Net.bloat-phase == 1 ? @tr("Downloading") : @tr("Uploading"))
                        + (Net.bloat-ping != "" ? "  ·  " + @tr("ping {}", Net.bloat-ping) : "")
                        + (Net.bloat-speed != "" ? "  ·  " + Net.bloat-speed : "");
                    color: Theme.text;
                    vertical-alignment: center;
                }
                if Net.bloat-state == 3 || Net.bloat-state == 4: Text {
                    text: Net.bloat-state == 3 ? @tr("1.1.1.1 doesn't answer pings from this network, so there's nothing to compare.")
                        : @tr("Couldn't reach the test server, speed.cloudflare.com.");
                    color: Theme.bad;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            if Net.bloat-state == 1: Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.background;
                Rectangle {
                    x: 0;
                    width: parent.width * Net.bloat-progress;
                    border-radius: 3px;
                    background: Theme.accent;
                    animate width { duration: 900ms; }
                }
            }
        }

        if Net.bloat-state == 2: Card {
            HorizontalLayout {
                spacing: 24px;

                Rectangle {
                    width: 92px;
                    height: 92px;
                    border-radius: Theme.radius;
                    background: root.grade-color.with-alpha(0.12);
                    border-width: 1px;
                    border-color: root.grade-color.with-alpha(0.4);
                    Text {
                        text: Net.bloat.grade;
                        color: root.grade-color;
                        font-family: Theme.display-font;
                        font-size: 52px;
                        font-weight: 700;
                    }
                }

                VerticalLayout {
                    spacing: 14px;
                    horizontal-stretch: 1;
                    alignment: center;

                    Text {
                        text: Net.bloat.grade == "A" ? @tr("No bufferbloat to speak of. Downloads in the house barely touch the ping.")
                            : Net.bloat.grade == "B" ? @tr("A little bufferbloat. Fine for most games and calls.")
                            : @tr("The ping jumps while the line is busy. Turn on SQM, Smart Queue or QoS in the router with limits a little under the speeds below, or limit the apps that download in the background.");
                        color: Theme.text;
                        font-weight: 600;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 32px;
                        alignment: start;
                        Figure {
                            label: @tr("At rest");
                            value: Net.bloat.idle;
                            detail: @tr("ping");
                        }
                        Figure {
                            label: @tr("Download");
                            value: Net.bloat.down-speed;
                            detail: Net.bloat.down-lost > 0
                                ? @tr("ping {} ({}), {} lost", Net.bloat.down-ping, Net.bloat.down-added, Net.bloat.down-lost)
                                : @tr("ping {} ({})", Net.bloat.down-ping, Net.bloat.down-added);
                        }
                        Figure {
                            label: @tr("Upload");
                            value: Net.bloat.up-speed;
                            detail: Net.bloat.up-lost > 0
                                ? @tr("ping {} ({}), {} lost", Net.bloat.up-ping, Net.bloat.up-added, Net.bloat.up-lost)
                                : @tr("ping {} ({})", Net.bloat.up-ping, Net.bloat.up-added);
                        }
                        Figure {
                            label: @tr("Data used");
                            value: Net.bloat.data;
                            detail: "";
                        }
                    }
                }
            }
        }
    }
}

component DnsTab inherits Card {
    pad: 14px;

    HorizontalLayout {
        spacing: 14px;
        padding-left: 6px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            Text {
                text: Net.dns-verdict == 1 ? @tr("The DNS you use now is as fast as the best one here.")
                    : Net.dns-verdict == 2 ? @tr("{} answers {} faster than the DNS you use now.", Net.dns-best, Net.dns-gain)
                    : Net.dns-verdict == 3 ? @tr("The DNS you use now missed {} queries. {} answered every one.", Net.dns-missed, Net.dns-best)
                    : @tr("Times how fast each DNS server answers, with real queries sent straight to it.");
                color: Net.dns-verdict == 1 ? Theme.accent : Net.dns-verdict >= 2 ? Theme.warn : Theme.text;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: @tr("DNS only decides how fast a site or server starts loading. It doesn't change the ping inside a game.");
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: Net.dns-running ? @tr("Testing...") : @tr("Run benchmark");
                icon: Icons.search;
                primary: !Net.dns-running;
                enabled: !Net.dns-running;
                clicked => { Net.run-dns(); }
            }
        }
    }

    if Net.dns.length > 0: HorizontalLayout {
        spacing: 16px;
        padding-left: 6px;
        padding-right: 14px;
        Heading { horizontal-stretch: 1; text: @tr("Server"); }
        Heading { width: 110px; text: @tr("Cached names"); horizontal-alignment: right; }
        Heading { width: 110px; text: @tr("New names"); horizontal-alignment: right; }
        Heading { width: 90px; text: @tr("Missed"); horizontal-alignment: right; }
        Rectangle { width: 96px; }
    }

    if Net.dns.length > 0: ListView {
        vertical-stretch: 1;
        for row[i] in Net.dns: HorizontalLayout {
            spacing: 16px;
            padding-left: 6px;
            padding-right: 14px;
            height: 50px;

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: row.name != "" ? row.name : row.address;
                        color: Theme.text;
                        font-weight: 600;
                    }
                    if row.name != "": Text {
                        text: row.address;
                        color: Theme.muted;
                        font-size: 12px;
                    }
                }
                if row.current: VerticalLayout {
                    alignment: center;
                    Chip { text: @tr("In use"); tint: Theme.info; }
                }
                if row.best: VerticalLayout {
                    alignment: center;
                    Chip { text: @tr("Fastest"); tint: Theme.accent; }
                }
            }
            Value { width: 110px; text: row.cached; }
            Value { width: 110px; text: row.uncached; }
            Value {
                width: 90px;
                text: row.failed + " / " + row.sent;
                color: row.failed > 1 ? Theme.bad : row.failed == 1 ? Theme.warn : Theme.muted;
            }
            HorizontalLayout {
                width: 96px;
                alignment: end;
                if row.vantix: VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Undo");
                        tall: 32px;
                        enabled: !Tweaks.busy;
                        clicked => { Net.undo-dns(); }
                    }
                }
                if !row.vantix && row.provider && !row.current && Net.dns-settable: VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Use");
                        tall: 32px;
                        primary: row.best;
                        enabled: !Tweaks.busy;
                        clicked => { Net.use-dns(i); }
                    }
                }
            }
        }
    }

    if Net.dns.length > 0 && !Net.dns-settable: Text {
        x: 6px;
        text: @tr("Vantix only changes the DNS of a cable, Wi-Fi or PPPoE connection. A VPN sets its own.");
        color: Theme.muted;
        font-size: 12px;
        wrap: word-wrap;
    }

    if Net.dns.length == 0: Rectangle { vertical-stretch: 1; }
}

component UsageTab inherits Card {
    pad: 14px;

    Text {
        x: 6px;
        text: Net.usage-failed ? @tr("Windows didn't allow the network trace, so traffic can't be counted.")
            : Net.upload-known ? @tr("TCP and UDP traffic of every program since this tab opened, games and voice chat included. Limit holds a program's upload to half your line, so it can't lag the rest.")
            : @tr("TCP and UDP traffic of every program since this tab opened, games and voice chat included. Run the Bufferbloat test once to limit a program's upload.");
        color: Net.usage-failed ? Theme.bad : Theme.muted;
        wrap: word-wrap;
    }

    HorizontalLayout {
        spacing: 16px;
        padding-left: 6px;
        padding-right: 14px;
        Heading { horizontal-stretch: 1; text: @tr("Program"); }
        Heading { width: 96px; text: @tr("Download"); horizontal-alignment: right; }
        Heading { width: 96px; text: @tr("Upload"); horizontal-alignment: right; }
        Heading { width: 150px; text: @tr("Total down / up"); horizontal-alignment: right; }
        Heading { width: 120px; text: @tr("Upload limit"); horizontal-alignment: right; }
    }

    if Net.usage.length == 0 && !Net.usage-failed: Text {
        x: 6px;
        text: @tr("Waiting for traffic...");
        color: Theme.faint;
        vertical-stretch: 1;
    }

    if Net.usage.length > 0: ListView {
        vertical-stretch: 1;
        for row in Net.usage: HorizontalLayout {
            spacing: 16px;
            padding-left: 6px;
            padding-right: 14px;
            height: 44px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 6px;
                Text {
                    text: row.name;
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }
                Rectangle {
                    height: 3px;
                    border-radius: 2px;
                    background: Theme.background;
                    Rectangle {
                        x: 0;
                        width: parent.width * row.share;
                        border-radius: 2px;
                        background: Theme.accent.with-alpha(0.7);
                    }
                }
            }
            Value { width: 96px; text: row.down; }
            Value { width: 96px; text: row.up; }
            Value {
                width: 150px;
                text: row.total-down + " / " + row.total-up;
                color: Theme.muted;
                font-weight: 400;
            }
            HorizontalLayout {
                width: 120px;
                alignment: end;
                if row.limit != "": VerticalLayout {
                    alignment: center;
                    Button {
                        text: row.limit;
                        icon: Icons.x;
                        tall: 30px;
                        enabled: !Tweaks.busy;
                        clicked => { Net.remove-limit(row.program); }
                    }
                }
                if row.limit == "" && row.can-limit: VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Limit");
                        tall: 30px;
                        enabled: !Tweaks.busy;
                        clicked => {
                            if Net.upload-known {
                                Net.limit-upload(row.program);
                            } else {
                                Net.tab = 1;
                            }
                        }
                    }
                }
            }
        }
    }
}

/// One layer of the connection test: state dot, name, what answered. A failure or a
/// warning puts its detail on a line of its own, so it wraps instead of being cut.
component DiagLine inherits VerticalLayout {
    in property <DiagRow> item;
    property <bool> flagged: self.item.state == 3 || self.item.state == 5;
    property <color> tone: self.item.state == 3 ? Theme.bad : self.item.state == 5 ? Theme.warn : Theme.text;

    padding-top: 4px;
    padding-bottom: 4px;
    spacing: 2px;

    HorizontalLayout {
        spacing: 8px;
        min-height: 30px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: root.item.state == 3 ? Theme.bad.with-alpha(0.18)
                    : root.item.state == 5 ? Theme.warn.with-alpha(0.18)
                    : root.item.state == 2 ? Theme.accent.with-alpha(0.18)
                    : root.item.state == 1 ? Theme.info.with-alpha(0.18) : transparent;
                border-width: root.item.state == 0 || root.item.state == 4 ? 1px : 0px;
                border-color: Theme.faint;
                if root.item.state == 2: Icon {
                    data: Icons.check;
                    size: 12px;
                    tint: Theme.accent;
                }
                if root.item.state == 3: Icon {
                    data: Icons.x;
                    size: 12px;
                    tint: Theme.bad;
                }
                if root.item.state == 5: Icon {
                    data: Icons.alert;
                    size: 12px;
                    tint: Theme.warn;
                }
                if root.item.state == 4: Rectangle {
                    width: 8px;
                    height: 1.5px;
                    background: Theme.faint;
                }
                if root.item.state == 1: Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.info;
                }
            }
        }
        Text {
            text: root.item.name;
            color: root.flagged ? root.tone : root.item.state == 4 ? Theme.muted : Theme.text;
            font-weight: root.flagged ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if !root.flagged: Text {
            text: root.item.detail;
            color: root.item.state == 4 ? Theme.faint : Theme.muted;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            width: min(420px, root.width * 0.6);
        }
        if root.flagged && root.item.fix >= 0: Button {
            text: @tr("Fix");
            tall: 30px;
            primary: true;
            enabled: !Tweaks.busy;
            clicked => { Net.fix-diag(root.item.fix); }
        }
        if root.item.go-dns: Button {
            text: @tr("DNS tab");
            tall: 30px;
            enabled: !Tweaks.busy;
            clicked => { Net.go-dns(); }
        }
    }
    if root.flagged && root.item.detail != "": Text {
        x: 28px;
        width: root.width - 28px;
        text: root.item.detail;
        color: root.tone;
        font-size: 12px;
        wrap: word-wrap;
    }
}

/// The repair card: one button walks the connection from the adapter up, proxy and
/// hosts checks always run, and the repair for each failed layer sits next to it.
component RepairTab inherits Card {
    property <string> explain: @tr("Walks your connection from the adapter up to the internet icon, then checks proxy, hosts, VPN and IPv6. The repair for each problem shows next to it.");

    pad: 14px;

    HorizontalLayout {
        spacing: 14px;
        padding-left: 6px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            Text {
                text: Net.diag-state == 3 ? @tr("Found where the connection breaks.")
                    : Net.diag-state == 4 ? @tr("The connection works. Some things below are worth a look.")
                    : Net.diag-state == 2 ? @tr("Every layer answers as it should.")
                    : root.explain;
                color: Net.diag-state == 2 ? Theme.accent : Net.diag-state == 3 ? Theme.bad
                    : Net.diag-state == 4 ? Theme.warn : Theme.text;
                font-weight: 600;
                wrap: word-wrap;
            }
            if Net.diag-cause > 0: Text {
                text: Net.diag-summary(Net.diag-cause);
                color: Theme.text;
                wrap: word-wrap;
            }
            // Once there are results, what the button does stays as a quiet line.
            if Net.diag-state >= 2: Text {
                text: root.explain;
                color: Theme.faint;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: Net.diag-state == 1 ? @tr("Diagnosing...") : @tr("Diagnose");
                icon: Icons.search;
                primary: Net.diag-state != 1;
                enabled: Net.diag-state != 1;
                clicked => { Net.run-diagnose(); }
            }
        }
    }

    if Net.diagnose.length > 0: VerticalLayout {
        padding-left: 6px;
        for row in Net.diagnose: DiagLine { item: row; }
    }
}

export component InternetPage inherits VerticalLayout {
    padding: 32px;
    padding-top: 26px;
    spacing: Theme.gap;

    HorizontalLayout {
        spacing: Theme.gap;
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: @tr("Internet");
                color: Theme.text;
                font-family: Theme.display-font;
                font-size: 28px;
                font-weight: 700;
            }
            Text {
                text: Net.adapter == "" ? @tr("No internet connection found.")
                    : Net.gateway == "" ? @tr("Connected through {}.", Net.adapter)
                    : @tr("Connected through {}, router at {}.", Net.adapter, Net.gateway);
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            Segmented {
                width: 540px;
                options: [@tr("Ping"), @tr("Bufferbloat"), @tr("DNS"), @tr("Network use"), @tr("Tweaks"), @tr("Repair")];
                selected <=> Net.tab;
            }
        }
    }

    if Net.tab == 0: PingTab { vertical-stretch: 1; }
    if Net.tab == 1: BloatTab { vertical-stretch: 1; }
    if Net.tab == 2: DnsTab { vertical-stretch: 1; }
    if Net.tab == 3: UsageTab { vertical-stretch: 1; }
    if Net.tab == 4: TweakList {
        vertical-stretch: 1;
        rows: Tweaks.network;
        if Tweaks.network.length == 0: Card {
            Text {
                text: @tr("Nothing to change on this connection: its adapter has none of these settings, or they're already where they should be.");
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
    }
    // The repairs sit straight in the page, so the whole page scrolls as one instead of
    // squeezing them into a scroll box of their own under the diagnosis.
    if Net.tab == 5: VerticalLayout {
        spacing: 12px;
        RepairTab { }
        TweakColumn {
            rows: Tweaks.internet;
            if Tweaks.internet.length == 0: Card {
                Text {
                    text: @tr("Every repair Vantix offers on this connection already ran, or there's nothing to fix.");
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}
